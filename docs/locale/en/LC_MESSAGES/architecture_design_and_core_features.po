msgstr ""
"Ascend runtime driver module, responsible for interfacing with runtime "
"environments such as CANN/TorchNPU, loading and launching compiled device-"
"side executable files."

#: ../../zh/architecture_design_and_core_features.md:0
msgid "`third_party/ascend/include/` 和 `third_party/ascend/lib/`"
msgstr "`third_party/ascend/include/` and `third_party/ascend/lib/`"

#: ../../zh/architecture_design_and_core_features.md:0
