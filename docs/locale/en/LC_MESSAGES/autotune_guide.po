msgid "Triton-Ascend autotune使用指南"
msgstr "Triton-Ascend autotune User Guide"

msgid "文档定位"
msgstr "Document Scope"

msgid "本文面向已经会写Triton kernel、也了解社区版 `triton.autotune` 基本概念的用户，重点说明Triton-Ascend的推荐用法："
msgstr "This guide targets users who can write Triton kernels and understand the basic concepts of the community version of `triton.autotune`, focusing on the recommended usage of Triton-Ascend:"

msgid "Triton-Ascend上的推荐autotune写法；"
msgstr "The recommended autotune syntax on Triton-Ascend;"

msgid "`configs=[]` 在Ascend后端中的含义；"
msgstr "The meaning of `configs=[]` in the Ascend backend;"

msgid "自动Tiling模式的适用边界，以及何时回到手写 `triton.Config`。"
msgstr "The applicability boundaries of automatic tiling mode, and when to fall back to handwritten `triton.Config`."

msgid "快速上手"
msgstr "Quick start"

msgid "在Triton-Ascend上，推荐保留社区版 `@triton.autotune` 的基本写法；当希望系统自动生成并评估候选配置时，将 `configs` 设为 `[]`："
msgstr "On Triton-Ascend, we recommend keeping the basic syntax of the community version `@triton.autotune`; when you want the system to automatically generate and evaluate candidate configurations, set `configs` to `[]`:"

msgid ""
"\"\"\"\n"
"Vector Add\n"
"=============\n"
"\"\"\"\n"
"\n"
"\n"
"import torch\n"
"import torch_npu\n"
"import triton\n"
"import triton.language as tl\n"
"import triton.backends.ascend.runtime\n"
"from triton.backends.ascend.testing import do_bench_npu\n"
"\n"
"\n"
"@triton.autotune(configs=[], key=[\"n_elements\"])\n"
"@triton.jit\n"
"def add_kernel(x_ptr,  # *Pointer* to first input vector.\n"
"               y_ptr,  # *Pointer* to second input vector.\n"
"               output_ptr,  # *Pointer* to output vector.\n"
"               n_elements,  # Size of the vector.\n"
"               BLOCK_SIZE: tl.constexpr,  # Number of elements each program should process.\n"
"               # NOTE: `constexpr` so it can be used as a shape value.\n"
"               ):\n"
"    # There are multiple 'programs' processing different data. We identify which program\n"
"    # we are here:\n"
"    pid = tl.program_id(axis=0)  # We use a 1D launch grid so axis is 0.\n"
"    # This program will process inputs that are offset from the initial data.\n"
"    # For instance, if you had a vector of length 256 and block_size of 64, the programs\n"
"    # would each access the elements [0:64, 64:128, 128:192, 192:256].\n"
"    # Note that offsets is a list of pointers:\n"
"    block_start = pid * BLOCK_SIZE\n"
"    offsets = block_start + tl.arange(0, BLOCK_SIZE)\n"
"    # Create a mask to guard memory operations against out-of-bounds accesses.\n"
"    mask = offsets < n_elements\n"
"    # Load x and y from DRAM, masking out any extra elements in case the input is not a\n"
"    # multiple of the block size.\n"
"    x = tl.load(x_ptr + offsets, mask=mask)\n"
"    y = tl.load(y_ptr + offsets, mask=mask)\n"
"    output = x + y\n"
"    # Write x + y back to DRAM.\n"
"    tl.store(output_ptr + offsets, output, mask=mask)\n"
"\n"
"\n"
"def add_torch(x, y):\n"
"    return x + y\n"
"\n"
"\n"
"def add_autotune(x, y):\n"
"    output = torch.empty_like(x)\n"
"    n_elements = output.numel()\n"
"    add_kernel[lambda meta: (triton.cdiv(n_elements, meta[\"BLOCK_SIZE\"]), )](x, y, output, n_elements)\n"
"    return output\n"
"\n"
"\n"
"def test_add(size: int):\n"
"    x = torch.rand(size, device=\"npu\")\n"
"    y = torch.rand(size, device=\"npu\")\n"
"\n"
"    output_torch = add_torch(x, y)\n"
"    output_triton = add_autotune(x, y)\n"
"    assert torch.allclose(output_triton, output_torch)\n"
"    print(f\"Vector Add {size} PASSED!\")\n"
"    triton_us = do_bench_npu(lambda: add_autotune(x, y))\n"
"    torch_us = do_bench_npu(lambda: add_torch(x, y))\n"
"    print(f\"Triton kernel execution time: {triton_us:.4f} ms\")\n"
"    print(f\"PyTorch kernel execution time: {torch_us:.4f} ms\")\n"
"\n"
"\n"
"if __name__ == \"__main__\":\n"
"    test_add(98432)\n"
msgstr ""
"\"\"\"\n"
"Vector Add\n"
"=============\n"
"\"\"\"\n"
"\n"
"\n"
"import torch\n"
"import torch_npu\n"
"import triton\n"
"import triton.language as tl\n"
"import triton.backends.ascend.runtime\n"
"from triton.backends.ascend.testing import do_bench_npu\n"
"\n"
"\n"
"@triton.autotune(configs=[], key=[\"n_elements\"])\n"
"@triton.jit\n"
"def add_kernel(x_ptr,  # *Pointer* to first input vector.\n"
"               y_ptr,  # *Pointer* to second input vector.\n"
"               output_ptr,  # *Pointer* to output vector.\n"
"               n_elements,  # Size of the vector.\n"
"               BLOCK_SIZE: tl.constexpr,  # Number of elements each program should process.\n"
"               # NOTE: `constexpr` so it can be used as a shape value.\n"
"               ):\n"
"    # There are multiple 'programs' processing different data. We identify which program\n"
"    # we are here:\n"
"    pid = tl.program_id(axis=0)  # We use a 1D launch grid so axis is 0.\n"
"    # This program will process inputs that are offset from the initial data.\n"
"    # For instance, if you had a vector of length 256 and block_size of 64, the programs\n"
"    # would each access the elements [0:64, 64:128, 128:192, 192:256].\n"
"    # Note that offsets is a list of pointers:\n"
"    block_start = pid * BLOCK_SIZE\n"
"    offsets = block_start + tl.arange(0, BLOCK_SIZE)\n"
"    # Create a mask to guard memory operations against out-of-bounds accesses.\n"
"    mask = offsets < n_elements\n"
"    # Load x and y from DRAM, masking out any extra elements in case the input is not a\n"
"    # multiple of the block size.\n"
"    x = tl.load(x_ptr + offsets, mask=mask)\n"
"    y = tl.load(y_ptr + offsets, mask=mask)\n"
"    output = x + y\n"
"    # Write x + y back to DRAM.\n"
"    tl.store(output_ptr + offsets, output, mask=mask)\n"
"\n"
"\n"
"def add_torch(x, y):\n"
"    return x + y\n"
"\n"
"\n"
"def add_autotune(x, y):\n"
"    output = torch.empty_like(x)\n"
"    n_elements = output.numel()\n"
"    add_kernel[lambda meta: (triton.cdiv(n_elements, meta[\"BLOCK_SIZE\"]), )](x, y, output, n_elements)\n"
"    return output\n"
"\n"
"\n"
"def test_add(size: int):\n"
"    x = torch.rand(size, device=\"npu\")\n"
"    y = torch.rand(size, device=\"npu\")\n"
"\n"
"    output_torch = add_torch(x, y)\n"
"    output_triton = add_autotune(x, y)\n"
"    assert torch.allclose(output_triton, output_torch)\n"
"    print(f\"Vector Add {size} PASSED!\")\n"
"    triton_us = do_bench_npu(lambda: add_autotune(x, y))\n"
"    torch_us = do_bench_npu(lambda: add_torch(x, y))\n"
"    print(f\"Triton kernel execution time: {triton_us:.4f} ms\")\n"
"    print(f\"PyTorch kernel execution time: {torch_us:.4f} ms\")\n"
"\n"
"\n"
"if __name__ == \"__main__\":\n"
"    test_add(98432)\n"

msgid "这表示："
msgstr "This means:"

msgid "`key` 的语义与社区版保持一致，用于决定哪些输入变化会触发重新选择配置；"
msgstr "The semantics of `key` are consistent with the community version and determine which input changes trigger configuration reselection;"

msgid "`configs=[]` 在Triton-Ascend中表示“由Ascend backend自动生成候选配置并完成寻优”，而不是“没有可选配置”。"
msgstr "In Triton-Ascend, `configs=[]` means \"the Ascend backend automatically generates candidate configurations and completes autotuning,\" rather than \"there are no optional configurations.\""

msgid "1. 先启用Ascend对autotune的扩展"
msgstr "1\\. First, enable the Ascend extension for autotune."

msgid "只有导入下面这行后，才会进入Triton-Ascend的autotune扩展路径："
msgstr "The Triton-Ascend autotune extension path is entered only after you import the following line:"

msgid ""
"import triton.backends.ascend.runtime\n"
msgstr ""
"import triton.backends.ascend.runtime\n"

msgid "如果没有这一步，使用的仍然是社区版 `triton.autotune`，`configs=[]` 也不会触发Ascend的自动Tiling生成。"
msgstr "If you skip this step, you still use the community version of `triton.autotune`, and `configs=[]` does not trigger the automatic Tiling generation of Ascend."

msgid "2. `@triton.autotune` 必须直接包在 `@triton.jit` 外层"
msgstr "2\\. `@triton.autotune` must directly wrap `@triton.jit`"

msgid "必须写成下面这种顺序："
msgstr "You must write it in the following order:"

msgid ""
"@triton.autotune(configs=[], key=[\"M\", \"N\"])\n"
"@triton.jit\n"
"def kernel(...):\n"
"    ...\n"
msgstr ""
"@triton.autotune(configs=[], key=[\"M\", \"N\"])\n"
"@triton.jit\n"
"def kernel(...):\n"
"    ...\n"

msgid "`@triton.autotune` 必须直接包在 `@triton.jit` 外层，不能在两者之间插入其他decorator。否则会导致无法对kernel DSL进行解析，从而无法进入Triton-Ascend的自动Tiling生成与寻优链路。"
msgstr "You must place `@triton.autotune` directly above `@triton.jit`. Do not insert other decorators between them. Otherwise, the system cannot parse the kernel DSL, which prevents the Triton-Ascend automatic tiling generation and tuning pipeline from running."

msgid "3. `key` 的含义与社区一致"
msgstr "3\\. The meaning of `key` is consistent with the community."

msgid "`key` 的本质是autotune的cache key。凡是填入 `key` 的参数，只要取值发生变化，就会触发重新autotune。"
msgstr "The essence of `key` is the autotune cache key. Whenever the value of any parameter passed into `key` changes, a re-autotune is triggered."

msgid "大多数情况下，`key` 里放的是 `M/N/K`、`seq_len`、`hidden_size` 这类shape参数，因为它们往往会显著影响最优Tiling；但 `key` 并不只限于shape参数，只要某个参数变化会影响配置选择，也可以放入 `key`。"
msgstr "In most cases, the `key` contains shape parameters such as `M/N/K`, `seq_len`, and `hidden_size`, because they often significantly affect the optimal tiling. However, the `key` is not limited to shape parameters. As long as a change in a parameter affects the configuration selection, it can also be placed in the `key`."

msgid "4. 希望参与自动调优的参数不要被提前固定"
msgstr "4\\. Parameters that you want to include in autotuning should not be fixed in advance"

msgid "如果希望某个 `tl.constexpr` 参与自动Tiling生成，需要同时满足下面三点："
msgstr "If you want a `tl.constexpr` to participate in automatic Tiling generation, you must meet the following three conditions simultaneously:"

msgid "它本身必须是Tiling参数，也就是会影响每个block（逻辑核）处理的数据规模或tile大小的参数；"
msgstr "It must be a Tiling parameter itself, that is, a parameter that affects the data size or tile size processed by each block (logical core);"

msgid "不要在launch时把它显式传值硬编码；"
msgstr "Do not hardcode it by explicitly passing the value at launch;"

msgid "不要在kernel定义里给它设置默认值。"
msgstr "Do not set a default value for it in the kernel definition."

msgid "例如下面这种写法，`BLOCK_M` 会参与自动调优："
msgstr "For example, in the following usage, `BLOCK_M` participates in autotuning:"

msgid ""
"kernel[grid](\n"
"    x,\n"
"    y,\n"
"    out,\n"
"    M,\n"
"    N,\n"
")\n"
msgstr ""
"kernel[grid](\n"
"    x,\n"
"    y,\n"
"    out,\n"
"    M,\n"
"    N,\n"
")\n"

msgid "如果你在launch时显式传入："
msgstr "If you explicitly pass in the following during launch:"

msgid ""
"kernel[grid](\n"
"    x,\n"
"    y,\n"
"    out,\n"
"    M,\n"
"    N,\n"
"    BLOCK_M=128,\n"
")\n"
msgstr ""
"kernel[grid](\n"
"    x,\n"
"    y,\n"
"    out,\n"
"    M,\n"
"    N,\n"
"    BLOCK_M=128,\n"
")\n"

msgid "那这个参数就已经被固定，不再属于自动生成范围。"
msgstr "Then this parameter is fixed and no longer falls within the automatic generation range."

msgid "同样，如果在kernel定义中给某个调优参数提供了默认值，例如："
msgstr "Similarly, if you provide a default value for a tuning parameter in the kernel definition, for example:"

msgid ""
"@triton.jit\n"
"def kernel(\n"
"    ...,\n"
"    BLOCK_M: tl.constexpr = 128,\n"
"):\n"
"    ...\n"
msgstr ""
"@triton.jit\n"
"def kernel(\n"
"    ...,\n"
"    BLOCK_M: tl.constexpr = 128,\n"
"):\n"
"    ...\n"

msgid "那么这个参数也不会参与自动调优。对于希望交给框架自动生成和寻优的参数，应该把它保留为“未在launch时显式传值、且在kernel定义中也没有默认值”的 `tl.constexpr`。"
msgstr "Then this parameter does not participate in autotuning either. For parameters that you want the framework to automatically generate and optimize, keep them as `tl.constexpr` variables that are 'not explicitly passed a value during launch, and have no default value in the kernel definition'."

msgid "5. 如果Tiling参数会影响grid，grid必须写成lambda形式"
msgstr "5\\. If the Tiling parameters affect the grid, write the grid in lambda form."

msgid "如果某个Tiling参数会影响grid大小，那么grid不能提前写成固定值或只依赖运行时参数的静态表达式，而必须写成依赖meta参数的 `lambda` 形式。这一点与社区autotune的要求一致。"
msgstr "If a tiling parameter affects the grid size, do not define the grid in advance as a fixed value or a static expression using only runtime parameters. Instead, you must write it as a `lambda` that depends on the meta parameters. This is consistent with the requirements of the community autotune."

msgid ""
"grid = lambda meta: (triton.cdiv(M, meta[\"BLOCK_M\"]),)\n"
msgstr ""
"grid = lambda meta: (triton.cdiv(M, meta[\"BLOCK_M\"]),)\n"

msgid "原因是autotune在评估不同候选配置时，`BLOCK_M` 这类参数的取值会变化；如果grid不随候选配置一起变化，就无法保证每个候选配置都以正确的发射方式执行。"
msgstr "The reason is that when autotune evaluates different candidate configurations, the values of parameters such as `BLOCK_M` change. If the grid does not change with the candidate configuration, you cannot guarantee that each candidate configuration executes in the correct launch manner."

msgid "使用注意事项"
msgstr "Usage Precautions"

msgid "autotune的benchmark语义与社区一致，会多次执行kernel。如果kernel存在副作用，例如包含原子操作、inplace写入，或会修改输入/输出buffer的累积状态，仍然需要通过社区已有的hook机制处理。"
msgstr "Autotune executes the kernel multiple times, and its benchmark semantics are consistent with the community. If the kernel has side effects, such as atomic operations, in-place writes, or modifying the accumulated state of input/output buffers, you still need to handle them using the existing community hook mechanism."

msgid "Triton-Ascend相比社区autotune的扩展"
msgstr "Triton-Ascend extensions compared to community autotune"

msgid "社区版 `triton.autotune` 的典型模式是：用户手工提供一组 `triton.Config`，框架做benchmark，然后缓存最优结果。"
msgstr "The typical pattern for the community version of `triton.autotune` is as follows: users manually provide a set of `triton.Config`, the framework runs benchmarks, and then caches the optimal result."

msgid "Triton-Ascend在保持这套接口习惯不变的前提下，主要扩展了下面几件事。"
msgstr "While maintaining these interface conventions, Triton-Ascend mainly extends the following features."

msgid "1. 支持 `configs=[]` 自动生成候选配置"
msgstr "1\\. Supports automatically generating candidate configurations using `configs=[]`"

msgid "这是最核心的扩展。用户不必先手写一组 `triton.Config`，而是可以把 `configs` 留空，让Ascend backend根据kernel DSL语义和运行时shape自动生成候选配置。"
msgstr "This is the core extension. You do not need to manually write a set of `triton.Config` first. Instead, you can leave `configs` empty. The Ascend backend then automatically generates candidate configurations based on the kernel DSL semantics and the runtime shape."

msgid "2. 支持多个config的并行编译"
msgstr "2\\. Supports parallel compilation of multiple configs"

msgid "当autotune需要评估多个候选配置时，Triton-Ascend默认会并行编译这些候选配置，以缩短首次调优时延。"
msgstr "When autotune needs to evaluate multiple candidate configurations, Triton-Ascend compiles them in parallel by default to reduce the initial tuning latency."

msgid "这一能力默认开启，可通过环境变量 `TRITON_AUTOTUNE_PARALLEL_COMPILE=0` 关闭。"
msgstr "This capability is enabled by default. You can disable it by setting the environment variable `TRITON_AUTOTUNE_PARALLEL_COMPILE=0`."

msgid "3. 支持使用profiler采集kernel性能"
msgstr "3\\. You can use the profiler to collect kernel performance."

msgid "Triton-Ascend支持在autotune做benchmark时切换性能采集方式：除了默认benchmark模式外，还可以使用profiler来采集每个候选config的kernel性能数据，它只关注kernel的片上计算时间，对于执行时间较短的kernel比默认性能采集方式更加精确，但会增加一些耗时。这项能力可通过环境变量 `TRITON_BENCH_METHOD='npu'` 开启。"
msgstr "Triton-Ascend supports switching the performance collection method when autotune runs a benchmark. In addition to the default benchmark mode, you can also use a profiler to collect the kernel performance data of each candidate configuration. The profiler focuses only on the on-chip computation time of the kernel. For kernels with short execution times, it is more precise than the default performance collection method, but it increases the time consumption. You can enable this capability by setting the environment variable `TRITON_BENCH_METHOD='npu'`."

msgid "自动Tiling生成能力的范围与行为"
msgstr "Scope and Behavior of the Automatic Tiling Generation Capability"

msgid "前面的第1点说明了Triton-Ascend支持 `configs=[]` 自动生成候选配置。对这项能力，进行以下几点说明。"
msgstr "Point 1 above explains that Triton-Ascend supports automatically generating candidate configurations using `configs=[]`. The following points provide further details about this capability."

msgid "1. 自动生成范围聚焦在Tiling参数"
msgstr "1\\. The auto-generated range focuses on tiling parameters"

msgid "Ascend自动生成的重点是kernel中与Tiling相关的 `tl.constexpr` 参数，也就是影响每个block（逻辑核）处理的数据规模或tile大小的参数。"
msgstr "Ascend autotune focuses on the Tiling-related `tl.constexpr` parameters in the kernel, that is, the parameters that affect the data size or tile size processed by each block (logical core)."

msgid "这套能力不等价于“自动帮你调所有参数”。像 `num_warps`、`num_stages` 这类编译参数，以及kernel的非Tiling参数，不属于当前自动生成范围。"
msgstr "This capability is not equivalent to \"automatically tuning all parameters for you.\" The current automatic generation scope does not include compilation parameters such as `num_warps` and `num_stages`, or non-Tiling parameters of the kernel."

msgid "2. 候选配置会带上Ascend硬件约束"
msgstr "2\\. Candidate configurations incorporate Ascend hardware constraints"

msgid "Ascend backend在生成候选时，会结合NPU的片上存储容量、对齐约束、核数利用等边界做筛选，而不是单纯枚举一批配置再盲目benchmark。"
msgstr "When generating candidates, the Ascend backend filters them based on NPU constraints such as on-chip memory capacity, alignment, and core utilization. It does not simply enumerate a batch of configurations and blindly benchmark them."

msgid "3. 自动Tiling模式的目标是方便给出“性能不错”的配置"
msgstr "3\\. The automatic Tiling mode aims to make it easy to provide configurations with good performance."

msgid "为了权衡寻优时间和寻优效果，当前自动Tiling会对生成配置数量做大量剪枝，因此并不保证自动生成结果一定能达到手工极致调优的性能上限。"
msgstr "To balance the tuning time and tuning effect, the current automatic Tiling performs heavy pruning on the number of generated configurations. Therefore, it does not guarantee that the automatically generated results reach the performance ceiling of manual extreme tuning."

msgid "这项能力的目标，是在尽量降低用户使用门槛和寻优成本的前提下，方便地给用户提供一个性能还不错的Tiling配置。"
msgstr "The goal of this capability is to easily provide users with a reasonably performant Tiling configuration while minimizing the usage barrier and tuning costs."

msgid "4. 自动Tiling生成失败时需要用户手写 `triton.Config`"
msgstr "4\\. When automatic Tiling generation fails, you must manually write `triton.Config`."

msgid "如果自动Tiling模式无法生成任何可用候选配置，这时需要用户改为手写 `triton.Config`。同时也建议对这类场景提issue，帮助Triton-Ascend后续补齐解析和自动生成能力。"
msgstr "If the automatic Tiling mode cannot generate any available candidate configurations, you need to manually write `triton.Config` instead. We also recommend submitting an issue for such scenarios to help Triton-Ascend improve its parsing and automatic generation capabilities."

msgid "手写 `triton.Config` 模式"
msgstr "Manually writing the `triton.Config` pattern"

msgid "如果自动Tiling模式生成失败，或生成的Tiling性能未达到预期，直接回到社区标准写法即可。Triton-Ascend对这部分语义保持兼容："
msgstr "If automatic Tiling mode generation fails, or the generated Tiling performance does not meet expectations, simply revert to the community standard approach. Triton-Ascend maintains compatibility with this part of the semantics:"

msgid ""
"@triton.autotune(\n"
"    configs=[\n"
"        triton.Config({\"BLOCK_M\": 128, \"BLOCK_N\": 128}),\n"
"        triton.Config({\"BLOCK_M\": 64, \"BLOCK_N\": 256}),\n"
"    ],\n"
"    key=[\"M\", \"N\"],\n"
")\n"
"@triton.jit\n"
"def kernel(...):\n"
"    ...\n"
msgstr ""
"@triton.autotune(\n"
"    configs=[\n"
"        triton.Config({\"BLOCK_M\": 128, \"BLOCK_N\": 128}),\n"
"        triton.Config({\"BLOCK_M\": 64, \"BLOCK_N\": 256}),\n"
"    ],\n"
"    key=[\"M\", \"N\"],\n"
")\n"
"@triton.jit\n"
"def kernel(...):\n"
"    ...\n"

msgid "这一模式下："
msgstr "In this mode:"

msgid "配置由用户手工提供；"
msgstr "The user manually provides the configuration;"

msgid "框架负责benchmark、选择最优配置和缓存复用；"
msgstr "The framework handles benchmarking, selecting the optimal configuration, and cache reuse;"

msgid "使用习惯与社区autotune保持一致。"
msgstr "Usage conventions are consistent with the community autotune."

msgid "查看调优日志"
msgstr "View tuning logs"

msgid "设置 `TRITON_PRINT_AUTOTUNING=1`，可查看调优日志。实际完成测速后，会打印调优耗时、最佳配置和各个成功配置的测速结果。以下为示意输出（`...` 表示省略的配置参数）："
msgstr "Set `TRITON_PRINT_AUTOTUNING=1` to view the tuning logs. After the speed test is complete, the system prints the tuning duration, best configuration, and speed test results of each successful configuration. The following is an example output (`...` indicates omitted configuration parameters):"

msgid ""
"Triton autotuning for function kernel finished after 0.12s; best config selected: BLOCK_M: 128, BLOCK_N: 128, ...;\n"
"Triton autotuning benchmark results for function kernel:\n"
"  config=BLOCK_M: 128, BLOCK_N: 128, ...; p50=0.0100 ms, p20=0.0090 ms, p80=0.0110 ms [selected]\n"
"  config=BLOCK_M: 64, BLOCK_N: 256, ...; p50=0.0140 ms, p20=0.0130 ms, p80=0.0150 ms\n"
msgstr ""
"Triton autotuning for function kernel finished after 0.12s; best config selected: BLOCK_M: 128, BLOCK_N: 128, ...;\n"
"Triton autotuning benchmark results for function kernel:\n"
"  config=BLOCK_M: 128, BLOCK_N: 128, ...; p50=0.0100 ms, p20=0.0090 ms, p80=0.0110 ms [selected]\n"
"  config=BLOCK_M: 64, BLOCK_N: 256, ...; p50=0.0140 ms, p20=0.0130 ms, p80=0.0150 ms\n"

msgid "`[selected]` 标记被选中的最佳配置。`p50`、`p20`、`p80` 分别为第50、20、80百分位耗时，单位为毫秒；若测速返回平均耗时，则显示 `mean=... ms`。"
msgstr "`[selected]` marks the selected best configuration. `p50`, `p20`, and `p80` indicate the 50th, 20th, and 80th percentile latency in milliseconds, respectively; if the speed test returns the average latency, the output displays `mean=... ms`."

msgid "用户配置（`configs`，包括通过 `hints` 展开的配置）发生失败，或调优因异常中断时，会打印相应配置的状态和原因。以下分别为编译失败和调优中断的示意输出："
msgstr "If a user configuration (`configs`, including configurations expanded through `hints`) fails, or an exception interrupts tuning, the system prints the status and reason of the corresponding configuration. The following shows sample outputs for a compilation failure and a tuning interruption, respectively:"

msgid ""
"Triton autotuning: config=BLOCK_M: 128, BLOCK_N: 128, ...; compile_failed; reason=CompileTimeAssertionFailure: <错误信息>\n"
"Triton autotuning: config=BLOCK_M: 64, BLOCK_N: 256, ...; not_evaluated; reason=No benchmark result was produced. Autotuning interrupted: RuntimeError: <错误信息>\n"
msgstr ""
"Triton autotuning: config=BLOCK_M: 128, BLOCK_N: 128, ...; compile_failed; reason=CompileTimeAssertionFailure: <error message>\n"
"Triton autotuning: config=BLOCK_M: 64, BLOCK_N: 256, ...; not_evaluated; reason=No benchmark result was produced. Autotuning interrupted: RuntimeError: <error message>\n"

msgid "其中，`compile_failed` 表示编译失败，`not_evaluated` 表示配置尚未完成评估，`reason` 给出失败或中断原因。"
msgstr "Here, `compile_failed` indicates a compilation failure, `not_evaluated` indicates an incomplete configuration evaluation, and `reason` provides the failure or interruption cause."

msgid "进阶用法：自动Tiling与其他参数联合调优"
msgstr "Advanced Usage: Joint Tuning of Automatic Tiling and Other Parameters"

msgid "以下内容属于进阶用法，只有当用户希望在自动Tiling模式下，继续联合调优kernel的非Tiling参数或编译参数时，再考虑使用。"
msgstr "The following content is for advanced usage. Consider it only if you want to continue jointly tuning non-tiling or compilation parameters of the kernel in automatic tiling mode."

msgid "1. 社区autotune：手工枚举全部调优参数"
msgstr "1\\. Community autotune: Manually enumerate all tuning parameters"

msgid "社区标准写法是由用户手工枚举所有候选配置："
msgstr "The standard community practice is for users to manually enumerate all candidate configurations:"

msgid ""
"@triton.autotune(\n"
"    configs=[\n"
"        triton.Config(\n"
"            {\n"
"                \"BLOCK_M\": BM,\n"
"                \"BLOCK_N\": BN,\n"
"                \"BLOCK_K\": BK,\n"
"                \"GROUP_SIZE_M\": GS,\n"
"            },\n"
"            num_warps=num_warps,\n"
"        )\n"
"        for BM in [16, 32, 64]\n"
"        for BN in [16, 32, 64]\n"
"        for BK in [16, 32, 64]\n"
"        for GS in [1, 2, 4, 8]\n"
"        for num_warps in [1, 2, 4, 8]\n"
"    ],\n"
"    key=[\"M\", \"N\", \"K\"],\n"
")\n"
"@triton.jit\n"
"def matmul_kernel(a, b, M, N, K, BLOCK_M, BLOCK_N, BLOCK_K, GROUP_SIZE_M):\n"
"    ...\n"
msgstr ""
"@triton.autotune(\n"
"    configs=[\n"
"        triton.Config(\n"
"            {\n"
"                \"BLOCK_M\": BM,\n"
"                \"BLOCK_N\": BN,\n"
"                \"BLOCK_K\": BK,\n"
"                \"GROUP_SIZE_M\": GS,\n"
"            },\n"
"            num_warps=num_warps,\n"
"        )\n"
"        for BM in [16, 32, 64]\n"
"        for BN in [16, 32, 64]\n"
"        for BK in [16, 32, 64]\n"
"        for GS in [1, 2, 4, 8]\n"
"        for num_warps in [1, 2, 4, 8]\n"
"    ],\n"
"    key=[\"M\", \"N\", \"K\"],\n"
")\n"
"@triton.jit\n"
"def matmul_kernel(a, b, M, N, K, BLOCK_M, BLOCK_N, BLOCK_K, GROUP_SIZE_M):\n"
"    ...\n"

msgid "2. Triton-Ascend：手工枚举Tiling参数和Ascend编译参数"
msgstr "2\\. Triton-Ascend: Manually enumerate Tiling parameters and Ascend compilation parameters"

msgid "在Triton-Ascend中，如果希望继续走手工枚举模式，也可以把Ascend侧参数一起放进手工配置空间："
msgstr "In Triton-Ascend, if you want to continue using the manual enumeration mode, you can also add the Ascend-side parameters to the manual configuration space:"

msgid ""
"@triton.autotune(\n"
"    configs=[\n"
"        triton.Config(\n"
"            {\n"
"                \"BLOCK_M\": BM,\n"
"                \"BLOCK_N\": BN,\n"
"                \"BLOCK_K\": BK,\n"
"                \"GROUP_SIZE_M\": GS,\n"
"                \"multibuffer\": MS,\n"
"            }\n"
"        )\n"
"        for BM in [16, 32, 64]\n"
"        for BN in [16, 32, 64]\n"
"        for BK in [16, 32, 64]\n"
"        for GS in [1, 2, 4, 8]\n"
"        for MS in [False, True]\n"
"    ],\n"
"    key=[\"M\", \"N\", \"K\"],\n"
")\n"
"@triton.jit\n"
"def matmul_kernel(a, b, M, N, K, BLOCK_M, BLOCK_N, BLOCK_K, GROUP_SIZE_M):\n"
"    ...\n"
msgstr ""
"@triton.autotune(\n"
"    configs=[\n"
"        triton.Config(\n"
"            {\n"
"                \"BLOCK_M\": BM,\n"
"                \"BLOCK_N\": BN,\n"
"                \"BLOCK_K\": BK,\n"
"                \"GROUP_SIZE_M\": GS,\n"
"                \"multibuffer\": MS,\n"
"            }\n"
"        )\n"
"        for BM in [16, 32, 64]\n"
"        for BN in [16, 32, 64]\n"
"        for BK in [16, 32, 64]\n"
"        for GS in [1, 2, 4, 8]\n"
"        for MS in [False, True]\n"
"    ],\n"
"    key=[\"M\", \"N\", \"K\"],\n"
")\n"
"@triton.jit\n"
"def matmul_kernel(a, b, M, N, K, BLOCK_M, BLOCK_N, BLOCK_K, GROUP_SIZE_M):\n"
"    ...\n"

msgid "3. Triton-Ascend：自动生成Tiling，同时联合调优其他参数"
msgstr "3\\. Triton-Ascend: Automatically generates tiling and jointly tunes other parameters."

msgid "如果希望Tiling参数继续由 `configs=[]` 自动生成，但又希望同时调优其他非Tiling参数或编译参数，可以把这些额外搜索维度通过 `hints` 传入："
msgstr "If you want the Tiling parameters to continue to be automatically generated by `configs=[]`, but also want to tune other non-Tiling parameters or compilation parameters, pass these additional search dimensions through `hints`:"

msgid ""
"@triton.autotune(\n"
"    configs=[],\n"
"    key=[\"M\", \"N\", \"K\"],\n"
"    hints={\n"
"        \"GROUP_SIZE_M\": [1, 2, 4, 8],\n"
"        \"multibuffer\": [False, True],\n"
"    },\n"
")\n"
"@triton.jit\n"
"def matmul_kernel(a, b, M, N, K, BLOCK_M, BLOCK_N, BLOCK_K, GROUP_SIZE_M):\n"
"    ...\n"
"\n"
"\n"
"grid = lambda meta: (triton.cdiv(M, meta[\"BLOCK_M\"]) * meta[\"GROUP_SIZE_M\"], triton.cdiv(N, meta[\"BLOCK_N\"]))\n"
"matmul_kernel[grid](a, b, M, N, K)\n"
msgstr ""
"@triton.autotune(\n"
"    configs=[],\n"
"    key=[\"M\", \"N\", \"K\"],\n"
"    hints={\n"
"        \"GROUP_SIZE_M\": [1, 2, 4, 8],\n"
"        \"multibuffer\": [False, True],\n"
"    },\n"
")\n"
"@triton.jit\n"
"def matmul_kernel(a, b, M, N, K, BLOCK_M, BLOCK_N, BLOCK_K, GROUP_SIZE_M):\n"
"    ...\n"
"\n"
"\n"
"grid = lambda meta: (triton.cdiv(M, meta[\"BLOCK_M\"]) * meta[\"GROUP_SIZE_M\"], triton.cdiv(N, meta[\"BLOCK_N\"]))\n"
"matmul_kernel[grid](a, b, M, N, K)\n"

msgid "这种方式的含义是："
msgstr "This approach means:"

msgid "Tiling相关参数仍然由Triton-Ascend自动生成；"
msgstr "Triton-Ascend still automatically generates the tiling-related parameters;"

msgid "非Tiling参数或编译参数（如 `GROUP_SIZE_M` 和 `multibuffer`）由用户通过 `hints` 显式给出候选集合；"
msgstr "You explicitly provide candidate sets for non-tiling parameters or compilation parameters (such as `GROUP_SIZE_M` and `multibuffer`) through `hints`;"

msgid "autotune会对两部分组合后的配置空间做评估。"
msgstr "Autotune evaluates the combined configuration space of the two parts."

