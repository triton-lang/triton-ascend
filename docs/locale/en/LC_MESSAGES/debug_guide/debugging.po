msgstr "<a id=\"debug-dump-files\"></a>"

msgid "<a id=\"debug-dump-files\">"
msgstr "<a id=\"debug-dump-files\">"

msgid "</a>"
msgstr "</a>"

msgid "3.2 调试转储文件（Dump Files）"
msgstr "3.2 Debugging Dump Files"

msgid "通过设置环境变量TRITON_DEBUG=1，可以在编译过程中将中间表示文件转储到磁盘，这些文件是调试编译问题的关键资源。"
msgstr "By setting the environment variable TRITON_DEBUG=1, you can dump intermediate representation files to disk during compilation. These files are key resources for debugging compilation issues."

msgid "转储目录结构："
msgstr "Dump directory structure:"

msgid "默认路径: ~/.triton/dump/"
msgstr "Default path: ~/.triton/dump/"

msgid "目录命名: 每个编译会话会生成一个以时间戳或唯一ID命名的子目录。"
msgstr "Directory naming: Each compilation session generates a subdirectory named with a timestamp or unique ID."

msgid "主要转储文件:"
msgstr "Primary dump file:"

msgid "kernel.ttir.mlir: Triton IR文件（编译输入）"
msgstr "kernel.ttir.mlir: Triton IR file (compilation input)"

msgid "kernel.ttadapter.mlir: 适配器IR文件（转换输出）"
msgstr "kernel.ttadapter.mlir: adapter IR file (conversion output)"

msgid "启用调试转储： 即使启用缓存，只要设置了TRITON_DEBUG=1，系统仍会在每次运行时重新生成转储文件（覆盖同名目录中的文件）。但若缓存命中且跳过编译，则可能不会触发IR转换，导致无新dump生成。因此调试时建议同时设置："
msgstr "Enabling debug dumps: Even if caching is enabled, as long as TRITON_DEBUG=1 is set, the system still regenerates dump files on each run (overwriting files in directories with the same name). However, if the cache is hit and compilation is skipped, the IR conversion may not be triggered, resulting in no new dumps being generated. Therefore, for debugging, it is recommended to also set:"

msgid ""
"# 在运行Triton程序前设置环境变量\n"
"export TRITON_DEBUG=1\n"
"export TRITON_ALWAYS_COMPILE=1\n"
"\n"
"# 运行Triton kernel\n"
"python your_triton_program.py\n"
msgstr ""
"# Set environment variables before running a Triton program\n"
"export TRITON_DEBUG=1\n"
"export TRITON_ALWAYS_COMPILE=1\n"
"\n"
"# Run the Triton kernel\n"
"python your_triton_program.py\n"

