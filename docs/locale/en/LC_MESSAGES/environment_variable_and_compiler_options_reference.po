msgstr "Unset; this environment variable no longer selects the Ascend backend policy."

msgid "`TRITON_DISABLE_FFTS`"
msgstr "`TRITON_DISABLE_FFTS`"

msgid "取消设置；FFTS policy 根据显式编译目标推导。"
msgstr "Unset; the FFTS policy is derived from the explicit compilation target."

msgid "`TRITON_REGISTER_TENSOR_MSPROF`"
msgstr "`TRITON_REGISTER_TENSOR_MSPROF`"

msgid "取消设置；tensor-shape msprof registration 不再由环境变量控制。"
msgstr "Unset; tensor-shape msprof registration is no longer controlled by an environment variable."
