msgstr "When set to `1`, automatic multi-buffering is disabled; other values use automatic mode without specifying the number of buffers for each level."

msgid "未设置 `multibuffer_mode` 时：后端 `2`，`triton.Config` 为 `3`；整数"
msgstr "When `multibuffer_mode` is not set: the backend is `2`, and `triton.Config` is `3`; integer"

msgid "`num_warps`"
msgstr "`num_warps`"

msgid "设置纯SIMT编译器的warp数。"
msgstr "Set the number of warps for the pure SIMT compiler."

msgid "后端 `32`；`triton.Config` 为 `4`；正整数"
msgstr "Backend `32`; `triton.Config` is `4`; a positive integer"

msgid "仅纯SIMT"
msgstr "Only pure SIMT"

msgid "`ir_override`"
msgstr "`ir_override`"

