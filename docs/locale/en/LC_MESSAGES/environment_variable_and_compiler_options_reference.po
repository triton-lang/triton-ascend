msgstr "`enable_auto_bind_sub_block`"

msgid "覆盖后端推导的sub-block自动绑定策略。"
msgstr "Overrides the backend-derived sub-block automatic binding strategy."

msgid "`enable_hivm_auto_cv_balance`"
