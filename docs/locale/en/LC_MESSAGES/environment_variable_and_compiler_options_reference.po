msgstr "Controls the automatic injection of barrier synchronization."

msgid "`inject_block_all`"
msgstr "`inject_block_all`"

msgid "控制自动注入block同步。"
msgstr "Controls the automatic injection of block synchronization."

msgid "`disable_auto_inject_block_sync`"
msgstr "`disable_auto_inject_block_sync`"

msgid "禁用编译器自动插入核间同步。使用Ascend亲和接口 `sync_block_all`、`sync_block_set` 或 `sync_block_wait` 时，必须设置 `disable_auto_inject_block_sync=True`。"
msgstr "Disable automatic insertion of inter-core synchronization by the compiler. When using the Ascend affinity interfaces `sync_block_all`, `sync_block_set`, or `sync_block_wait`, you must set `disable_auto_inject_block_sync=True`."

msgid "调度与流水"
msgstr "Scheduling and Pipelining"

