msgstr "`enable_graph_optimize`"

msgid "控制TTIR Graph Optimization。"
msgstr "Controls TTIR Graph Optimization."

msgid "多缓冲"
msgstr "Multi-buffer"

msgid "`multibuffer`"
msgstr "`multibuffer`"

msgid "控制自动多缓冲总开关；`num_stages=1` 也会将其关闭。"
msgstr "Controls the master switch for automatic multi-buffering; `num_stages=1` also disables it."

msgid "`multibuffer_mode`"
msgstr "`multibuffer_mode`"

msgid "按 `gm`、`l1`、`l0c`、`ub` 设置多缓冲槽数；`1` 关闭该层多缓冲，大于 `1` 指定槽数。受 `multibuffer` 总开关控制，不能与 `num_stages` 同时显式设置。"
msgstr "Set the number of multi-buffer slots for `gm`, `l1`, `l0c`, and `ub`; `1` disables multi-buffer for the layer, and a value greater than `1` specifies the number of slots. The `multibuffer` master switch controls this option, and you cannot explicitly set it together with `num_stages`."

