"triton.Config({\"multibuffer_mode\": {\"gm\": 1, \"l1\": 2, \"l0c\": 1, \"ub\": 1}})\n"
msgstr ""
"triton.Config({\"multibuffer_mode\": {\"gm\": 1, \"l1\": 2, \"l0c\": 1, \"ub\": 1}})\n"

