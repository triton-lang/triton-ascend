msgid "融合Softmax（Fused Softmax）"
msgstr "Fused Softmax"

msgid "在本节中，我们将使用Triton编写一个融合的softmax操作的程序。 在此过程中，你会学习到："
msgstr "In this section, you will use Triton to write a program for a fused softmax operation. During this process, you will learn:"

msgid "内核融合对于带宽受限操作的优势"
msgstr "Advantages of kernel fusion for bandwidth-bound operations"

msgid "Triton中的缩减操作"
msgstr "Reduction operations in Triton"

msgid "原生PyTorch逐行进行Softmax计算"
msgstr "Native PyTorch performs Softmax computation row by row"

msgid ""
"import torch\n"
"import torch_npu\n"
"\n"
"import triton\n"
"import triton.language as tl\n"
"\n"
"def naive_softmax(x):\n"
"    \"\"\"\n"
"    我们减去最大元素以避免溢出。Softmax对于这种偏移是不变的。\n"
"    \"\"\"\n"
"    # 读取MN个元素；写入M个元素\n"
"    x_max = x.max(dim=1)[0]\n"
"    # 读取MN + M个元素；写入MN个元素\n"
"    z = x - x_max[:, None]\n"
"    # 读取MN个元素；写入MN个元素\n"
"    numerator = torch.exp(z)\n"
"    # 读取MN个元素；写入M个元素\n"
"    denominator = numerator.sum(dim=1)\n"
"    # 读取MN + M个元素；写入MN个元素\n"
"    ret = numerator / denominator[:, None]\n"
"    # 总计：读取5MN + 2M个元素；写入3MN + 2M个元素\n"
"    return ret\n"
msgstr ""
"import torch\n"
"import torch_npu\n"
"\n"
"import triton\n"
"import triton.language as tl\n"
"\n"
"def naive_softmax(x):\n"
"    \"\"\"\n"
"    We subtract the maximum element to avoid overflow. Softmax is invariant to this shift.\n"
"    \"\"\"\n"
"    # Reads MN elements; writes M elements\n"
"    x_max = x.max(dim=1)[0]\n"
"    # Reads MN + M elements; writes MN elements\n"
"    z = x - x_max[:, None]\n"
"    # Reads MN elements; writes MN elements\n"
"    numerator = torch.exp(z)\n"
"    # Reads MN elements; writes M elements\n"
"    denominator = numerator.sum(dim=1)\n"
"    # Reads MN + M elements; writes MN elements\n"
"    ret = numerator / denominator[:, None]\n"
"    # Total: reads 5MN + 2M elements; writes 3MN + 2M elements\n"
"    return ret\n"

msgid "内核融合的目的"
msgstr "Purpose of kernel fusion"

msgid "当在PyTorch中以原生方式实现时，计算`y=naive_softmax(x)`需要从DRAM中读取5MN+2M个元素，并写回3MN+2M个元素。显然这是非常低效的；我们更希望使用一个自定义的“融合”内核，它只需读取一次x，并在芯片上完成所有必要的计算。 这样一来只需读取和写回2MN个元素，因此我们可以期望理论上的加速比大约为4倍（即 (8MN+4M)/2MN）。"
msgstr "When implemented natively in PyTorch, computing `y=naive_softmax(x)` requires reading 5MN+2M elements from DRAM and writing back 3MN+2M elements. Clearly, this is highly inefficient; it is preferable to use a custom \"fused\" kernel that reads x only once and performs all necessary computations on-chip. This way, only 2MN elements need to be read and written back, so you can expect a theoretical speedup of approximately 4x (that is, (8MN+4M)/2MN)."

msgid "`torch.jit.script`旨在自动执行这种“内核融合”，但它仍然远未达到理想状态。"
msgstr "`torch.jit.script` aims to automatically perform this \"kernel fusion\", but it is still far from the ideal state."

msgid "计算内核"
msgstr "compute kernel"

msgid "softmax内核工作原理如下：每个计算单元（program）以程序数量为步长加载输入矩阵X的一组行数据，执行归一化处理后，将结果写入输出矩阵Y。 注意：Triton的一个重要限制是每个块必须包含2的幂个元素，因此，如果我们要处理任意可能的输入形状，需要在内部「填充」每一行，并确保内存操作正确性。"
msgstr "The softmax kernel works as follows: each compute unit (program) loads a set of rows from the input matrix X, stepping by the number of programs. After performing normalization, the unit writes the results to the output matrix Y. Note: An important limitation of Triton is that each block must contain a power of 2 elements. Therefore, to handle any possible input shape, you must internally \"pad\" each row and ensure correct memory operations."

msgid ""
"@triton.jit\n"
"def softmax_kernel(output_ptr, input_ptr, input_row_stride, output_row_stride, n_rows, n_cols, BLOCK_SIZE: tl.constexpr):\n"
"    # 程序起始行\n"
"    row_start = tl.program_id(0)\n"
"    row_step = tl.num_programs(0)\n"
"    for row_idx in tl.range(row_start, n_rows, row_step):\n"
"        # 步长表示我们需要对指针增加多少以推进1行\n"
"        row_start_ptr = input_ptr + row_idx * input_row_stride\n"
"        # 块大小是大于n_cols的下一个二的幂，因此我们可以适配\n"
"        # 单个块中的行\n"
"        col_offsets = tl.arange(0, BLOCK_SIZE)\n"
"        input_ptrs = row_start_ptr + col_offsets\n"
"        # 将行加载到SRAM中，使用掩码，因为BLOCK_SIZE可能大于n_cols\n"
"        mask = col_offsets < n_cols\n"
"        row = tl.load(input_ptrs, mask=mask, other=-float('inf'))\n"
"        # 为了数值稳定性而减去最大值\n"
"        row_minus_max = row - tl.max(row, axis=0)\n"
"        # 请注意，Triton中的指数运算速度很快，但是是近似的。\n"
"        numerator = tl.exp(row_minus_max)\n"
"        denominator = tl.sum(numerator, axis=0)\n"
"        softmax_output = numerator / denominator\n"
"        # 将输出写回DRAM\n"
"        output_row_start_ptr = output_ptr + row_idx * output_row_stride\n"
"        output_ptrs = output_row_start_ptr + col_offsets\n"
"        tl.store(output_ptrs, softmax_output, mask=mask)\n"
msgstr ""
"@triton.jit\n"
"def softmax_kernel(output_ptr, input_ptr, input_row_stride, output_row_stride, n_rows, n_cols, BLOCK_SIZE: tl.constexpr):\n"
"    # Program starting row\n"
"    row_start = tl.program_id(0)\n"
"    row_step = tl.num_programs(0)\n"
"    for row_idx in tl.range(row_start, n_rows, row_step):\n"
"        # The stride indicates how much to increment the pointer to advance by 1 row\n"
"        row_start_ptr = input_ptr + row_idx * input_row_stride\n"
"        # The block size is the next power of two greater than n_cols, so we can fit\n"
"        # the row in a single block\n"
"        col_offsets = tl.arange(0, BLOCK_SIZE)\n"
"        input_ptrs = row_start_ptr + col_offsets\n"
"        # Load the row into SRAM, using a mask because BLOCK_SIZE may be greater than n_cols\n"
"        mask = col_offsets < n_cols\n"
"        row = tl.load(input_ptrs, mask=mask, other=-float('inf'))\n"
"        # Subtract the maximum for numerical stability\n"
"        row_minus_max = row - tl.max(row, axis=0)\n"
"        # Note that the exponential operation in Triton is fast but approximate.\n"
"        numerator = tl.exp(row_minus_max)\n"
"        denominator = tl.sum(numerator, axis=0)\n"
"        softmax_output = numerator / denominator\n"
"        # Write the output back to DRAM\n"
"        output_row_start_ptr = output_ptr + row_idx * output_row_stride\n"
"        output_ptrs = output_row_start_ptr + col_offsets\n"
"        tl.store(output_ptrs, softmax_output, mask=mask)\n"

msgid "我们可以创建一个辅助函数，该函数能够将内核及其元参数加入执行队列，以处理任意给定的输入张量。"
msgstr "You can create a helper function that enqueues the kernel and its meta-parameters to process any given input tensor."

msgid ""
"kernels = {}\n"
"\n"
"def softmax(x):\n"
"    n_rows, n_cols = x.shape\n"
"\n"
"    # 每次循环迭代的块大小是大于或等于`x`列数的最小二的幂\n"
"    BLOCK_SIZE = triton.next_power_of_2(n_cols)\n"
"    # 分配输出空间\n"
"    y = torch.empty_like(x)\n"
"\n"
"    # 以BLOCK_SIZE为键缓存内核和程序数，避免同一块大小重复编译。\n"
"    kernel, num_programs = kernels.get(BLOCK_SIZE, (None, 0))\n"
"    if kernel is None:\n"
"        num_programs = 32  # 每个内核固定启动32个程序并行处理，随后按行数n_rows截断\n"
"        kernel = softmax_kernel\n"
"        kernels[BLOCK_SIZE] = (kernel, num_programs)\n"
"\n"
"    num_programs = min(num_programs, n_rows)\n"
"\n"
"    kernel[(num_programs, 1, 1)](\n"
"        y,\n"
"        x,\n"
"        x.stride(0),\n"
"        y.stride(0),\n"
"        n_rows,\n"
"        n_cols,\n"
"        BLOCK_SIZE\n"
"    )\n"
"    return y\n"
msgstr ""
"kernels = {}\n"
"\n"
"def softmax(x):\n"
"    n_rows, n_cols = x.shape\n"
"\n"
"    # The block size for each iteration is the smallest power of two greater than or equal to the number of columns in `x`\n"
"    BLOCK_SIZE = triton.next_power_of_2(n_cols)\n"
"    # Allocate output space\n"
"    y = torch.empty_like(x)\n"
"\n"
"    # Cache the kernel and the number of programs using BLOCK_SIZE as the key to avoid repeated compilation for the same block size.\n"
"    kernel, num_programs = kernels.get(BLOCK_SIZE, (None, 0))\n"
"    if kernel is None:\n"
"        num_programs = 32  # Each kernel launches a fixed 32 programs for parallel processing, then truncated by the number of rows n_rows\n"
"        kernel = softmax_kernel\n"
"        kernels[BLOCK_SIZE] = (kernel, num_programs)\n"
"\n"
"    num_programs = min(num_programs, n_rows)\n"
"\n"
"    kernel[(num_programs, 1, 1)](\n"
"        y,\n"
"        x,\n"
"        x.stride(0),\n"
"        y.stride(0),\n"
"        n_rows,\n"
"        n_cols,\n"
"        BLOCK_SIZE\n"
"    )\n"
"    return y\n"

msgid "单元测试"
msgstr "Unit Testing"

msgid "需要在一个具有不规则行和列数的矩阵上测试处理好的内核，此举可以验证Padding机制是否起作用。"
msgstr "Test the processed kernel on a matrix with irregular numbers of rows and columns to verify whether the padding mechanism works."

msgid ""
"torch.manual_seed(0)    # 固定随机种子，保证结果可复现\n"
"x = torch.randn(1823, 781, device='npu')\n"
"y_triton = softmax(x)\n"
"y_torch = torch.softmax(x, axis=1)\n"
"assert torch.allclose(y_triton, y_torch), (y_triton, y_torch)\n"
"print(y_triton)\n"
"print(y_torch)\n"
"print(f'The maximum difference between torch and triton is '\n"
"      f'{torch.max(torch.abs(y_triton-y_torch))}')\n"
msgstr ""
"torch.manual_seed(0)    # Fix the random seed to ensure reproducible results\n"
"x = torch.randn(1823, 781, device='npu')\n"
"y_triton = softmax(x)\n"
"y_torch = torch.softmax(x, axis=1)\n"
"assert torch.allclose(y_triton, y_torch), (y_triton, y_torch)\n"
"print(y_triton)\n"
"print(y_torch)\n"
"print(f'The maximum difference between torch and triton is '\n"
"      f'{torch.max(torch.abs(y_triton-y_torch))}')\n"

