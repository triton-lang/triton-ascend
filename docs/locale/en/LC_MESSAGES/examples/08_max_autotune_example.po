msgid "max_autotune 使用示例"
msgstr "max_autotune usage example"

msgid "`max_autotune` 是 Triton-Ascend 提供的增强自动调优装饰器，旨在简化多参数调优的代码编写。与社区版 `autotune` 要求用户手动枚举所有 `triton.Config` 不同，`max_autotune` 允许用户仅提供少量基础配置（如分块大小），并自动将相关的编译器选项（如 `num_stages`、`enable_hivm_auto_cv_balance` 等）纳入最优组合的搜索空间。用户也可以通过参数列表显式控制搜索范围。"
msgstr "`max_autotune` is an enhanced autotuning decorator provided by Triton-Ascend, designed to simplify the code writing for multi-parameter tuning. Unlike the community version `autotune` that requires users to manually enumerate all `triton.Config` entries, `max_autotune` allows users to provide only a few basic configurations (such as block size) and automatically includes related compiler options (such as `num_stages`, `enable_hivm_auto_cv_balance`, and so on) in the search space for the optimal combination. Users can also explicitly control the search scope through the parameter list."

msgid "**适用场景**：Ascend NPU 上的 `cube`、`mix`、`vector` 算子，尤其适合需要同时调整多个硬件相关参数的场景。"
msgstr "**Applicable scenarios**: `cube`, `mix`, and `vector` operators on the Ascend NPU, especially useful when you need to adjust multiple hardware-related parameters simultaneously."

msgid "基本使用示例"
msgstr "Basic usage example"

msgid "以下示例演示了使用 `max_autotune` 对一个简单的向量加法 kernel 进行自动调优。与社区版 `autotune` 相比，`max_autotune` 还会自动将不同的编译器选项纳入调优空间，无需用户手动指定。"
msgstr "The following sample demonstrates using `max_autotune` to autotune a simple vector addition kernel. Compared with the community version `autotune`, `max_autotune` also automatically incorporates different compilation options into the tuning space, without requiring you to manually specify them."

msgid ""
"import torch\n"
"import torch_npu\n"
"import triton\n"
"import triton.language as tl\n"
"from triton.backends.ascend.runtime import max_autotune\n"
"\n"
"def test_max_autotune():\n"
"\n"
"    # 基础配置：只需提供分块大小，其他调优参数由装饰器自动生成\n"
"    base_configs = [\n"
"        triton.Config({'BLOCK_SIZE': 128}),\n"
"        triton.Config({'BLOCK_SIZE': 256}),\n"
"    ]\n"
"\n"
"    @max_autotune(\n"
"        configs=base_configs,\n"
"        key=[\"numel\"],\n"
"        kernel_type=\"vector\",          # 算子类型：cube / mix / vector, 默认为mix\n"
"    )\n"
"    @triton.jit\n"
"    def triton_calc_kernel(\n"
"        out_ptr0, in_ptr0, in_ptr1, numel,\n"
"        BLOCK_SIZE: tl.constexpr\n"
"    ):\n"
"        pid = tl.program_id(0)\n"
"        idx = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n"
"        mask = idx < numel\n"
"\n"
"        # 模拟计算负载\n"
"        for i in range(10000):\n"
"            tmp0 = tl.load(in_ptr0 + idx, mask=mask, other=0.0)\n"
"            tmp1 = tl.load(in_ptr1 + idx, mask=mask, other=0.0)\n"
"            tmp2 = tl.math.exp(tmp0) + tmp1 + i\n"
"            tl.store(out_ptr0 + idx, tmp2, mask=mask)\n"
"\n"
"    # 封装调用函数\n"
"    def triton_calc_func(x0, x1):\n"
"        n = x0.numel()\n"
"        y0 = torch.empty_like(x0)\n"
"        grid = lambda meta: (triton.cdiv(n, meta[\"BLOCK_SIZE\"]),)\n"
"        triton_calc_kernel[grid](y0, x0, x1, n)\n"
"        return y0\n"
"\n"
"    # 与 PyTorch 参考结果对比\n"
"    def torch_calc_func(x0, x1):\n"
"        return torch.exp(x0) + x1 + 10000 - 1\n"
"\n"
"    DEV = \"npu\"\n"
"    DTYPE = torch.float32\n"
"    N = 192 * 1024\n"
"    x0 = torch.randn((N,), dtype=DTYPE, device=DEV)\n"
"    x1 = torch.randn((N,), dtype=DTYPE, device=DEV)\n"
"    torch_ref = torch_calc_func(x0, x1)\n"
"    triton_cal = triton_calc_func(x0, x1)\n"
"    torch.testing.assert_close(triton_cal, torch_ref)\n"
"\n"
"if __name__ == \"__main__\":\n"
"    test_max_autotune()\n"
"    print(\"success: test_max_autotune\")\n"
msgstr ""
"import torch\n"
"import torch_npu\n"
"import triton\n"
"import triton.language as tl\n"
"from triton.backends.ascend.runtime import max_autotune\n"
"\n"
"def test_max_autotune():\n"
"\n"
"    # Base configuration: Only provide the block size. The decorator automatically generates other tuning parameters.\n"
"    base_configs = [\n"
"        triton.Config({'BLOCK_SIZE': 128}),\n"
"        triton.Config({'BLOCK_SIZE': 256}),\n"
"    ]\n"
"\n"
"    @max_autotune(\n"
"        configs=base_configs,\n"
"        key=[\"numel\"],\n"
"        kernel_type=\"vector\",          # Operator type: cube / mix / vector. The default value is mix.\n"
"    )\n"
"    @triton.jit\n"
"    def triton_calc_kernel(\n"
"        out_ptr0, in_ptr0, in_ptr1, numel,\n"
"        BLOCK_SIZE: tl.constexpr\n"
"    ):\n"
"        pid = tl.program_id(0)\n"
"        idx = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n"
"        mask = idx < numel\n"
"\n"
"        # Simulate the computation workload\n"
"        for i in range(10000):\n"
"            tmp0 = tl.load(in_ptr0 + idx, mask=mask, other=0.0)\n"
"            tmp1 = tl.load(in_ptr1 + idx, mask=mask, other=0.0)\n"
"            tmp2 = tl.math.exp(tmp0) + tmp1 + i\n"
"            tl.store(out_ptr0 + idx, tmp2, mask=mask)\n"
"\n"
"    # Wrapper function for invocation\n"
"    def triton_calc_func(x0, x1):\n"
"        n = x0.numel()\n"
"        y0 = torch.empty_like(x0)\n"
"        grid = lambda meta: (triton.cdiv(n, meta[\"BLOCK_SIZE\"]),)\n"
"        triton_calc_kernel[grid](y0, x0, x1, n)\n"
"        return y0\n"
"\n"
"    # Compare with the PyTorch reference results\n"
"    def torch_calc_func(x0, x1):\n"
"        return torch.exp(x0) + x1 + 10000 - 1\n"
"\n"
"    DEV = \"npu\"\n"
"    DTYPE = torch.float32\n"
"    N = 192 * 1024\n"
"    x0 = torch.randn((N,), dtype=DTYPE, device=DEV)\n"
"    x1 = torch.randn((N,), dtype=DTYPE, device=DEV)\n"
"    torch_ref = torch_calc_func(x0, x1)\n"
"    triton_cal = triton_calc_func(x0, x1)\n"
"    torch.testing.assert_close(triton_cal, torch_ref)\n"
"\n"
"if __name__ == \"__main__\":\n"
"    test_max_autotune()\n"
"    print(\"success: test_max_autotune\")\n"

msgid "进阶使用示例"
msgstr "Advanced Usage Sample"

msgid "用户可以通过装饰器直接传入 `num_stages` 等参数，显式指定需要调优的编译器选项及其取值列表；未指定的参数会使用内置默认值。以下示例展示了如何对多个参数进行组合搜索。"
msgstr "You can directly pass parameters such as `num_stages` through the decorator to explicitly specify the compiler options to tune and their value lists. Unspecified parameters use built-in default values. The following example shows how to perform a combined search on multiple parameters."

msgid ""
"import triton\n"
"import triton.language as tl\n"
"from triton.backends.ascend.runtime import max_autotune\n"
"\n"
"def test_max_autotune():\n"
"\n"
"    # 基础配置：只需提供分块大小，其他调优参数由装饰器自动生成\n"
"    base_configs = [\n"
"        triton.Config({'BLOCK_SIZE': 128}),\n"
"        triton.Config({'BLOCK_SIZE': 256}),\n"
"    ]\n"
"\n"
"    @max_autotune(\n"
"        configs=base_configs,          # 基础配置列表\n"
"        key=[\"numel\"],                 # 当 numel 变化时触发重新调优\n"
"        kernel_type=\"vector\",          # 算子类型：cube / mix / vector\n"
"        # 以下参数为可选的调优列表，不提供时使用内置默认值\n"
"        num_stages=[1, 2],\n"
"        enable_ubuf_saving=[True, False]\n"
"    )\n"
"    @triton.jit\n"
"    def triton_calc_kernel(\n"
"        out_ptr0, in_ptr0, in_ptr1, numel,\n"
"        BLOCK_SIZE: tl.constexpr,\n"
"        **META\n"
"    ):\n"
"        pass\n"
msgstr ""
"import triton\n"
"import triton.language as tl\n"
"from triton.backends.ascend.runtime import max_autotune\n"
"\n"
"def test_max_autotune():\n"
"\n"
"    # Base configuration: provide only the block size; the decorator automatically generates other tuning parameters\n"
"    base_configs = [\n"
"        triton.Config({'BLOCK_SIZE': 128}),\n"
"        triton.Config({'BLOCK_SIZE': 256}),\n"
"    ]\n"
"\n"
"    @max_autotune(\n"
"        configs=base_configs,          # Base configuration list\n"
"        key=[\"numel\"],                 # Triggers re-tuning when numel changes\n"
"        kernel_type=\"vector\",          # Operator type: cube / mix / vector\n"
"        # The following parameters are optional tuning lists; if not provided, built-in default values are used\n"
"        num_stages=[1, 2],\n"
"        enable_ubuf_saving=[True, False]\n"
"    )\n"
"    @triton.jit\n"
"    def triton_calc_kernel(\n"
"        out_ptr0, in_ptr0, in_ptr1, numel,\n"
"        BLOCK_SIZE: tl.constexpr,\n"
"        **META\n"
"    ):\n"
"        pass\n"
