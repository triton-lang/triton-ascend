msgid "Costmodel 端到端示例"
msgstr "Costmodel end-to-end sample"

msgid "本示例展示 costmodel 后端的基本调用流程："
msgstr "This sample demonstrates the basic invocation flow of the costmodel backend:"

msgid "使用 Triton 前端算子生成 TTIR；"
msgstr "Use Triton frontend operators to generate TTIR;"

msgid "为多个候选 config 构造 `costmodel_bench` item；"
msgstr "Construct `costmodel_bench` items for multiple candidate configurations;"

msgid "对每个 item 调用一次 `costmodel_bench`，并汇总每个 config 的预测耗时。"
msgstr "Call `costmodel_bench` once for each item, and aggregate the predicted time cost for each config."

msgid "这个流程适合在 autotune 前快速筛掉预计性能较差的 config。示例只使用向量加法 kernel，便于聚焦 costmodel 的输入和返回值。"
msgstr "This process is suitable for quickly filtering out configs with poor expected performance before autotune. The sample uses only a vector addition kernel to help you focus on the input and return values of the costmodel."

msgid "完整示例"
msgstr "Complete sample"

msgid "将下面的代码保存为 `costmodel_example.py` 后运行："
msgstr "Save the following code as `costmodel_example.py` and run it:"

msgid ""
"from __future__ import annotations\n"
"\n"
"import triton\n"
"import triton.language as tl\n"
"from triton.backends.ascend.runtime.costmodel_runtime import costmodel_bench\n"
"from triton.backends.compiler import GPUTarget\n"
"from triton.compiler import ASTSource\n"
"from triton.compiler.code_generator import ast_to_ttir\n"
"from triton.compiler.compiler import make_backend\n"
"from triton._C.libtriton import ir\n"
"from triton._C.libtriton.ascend import ir as ascend_ir\n"
"\n"
"\n"
"@triton.jit\n"
"def add_kernel(x_ptr, y_ptr, output_ptr, n_elements, BLOCK_SIZE: tl.constexpr):\n"
"    pid = tl.program_id(axis=0)\n"
"    offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n"
"    mask = offsets < n_elements\n"
"    x = tl.load(x_ptr + offsets, mask=mask)\n"
"    y = tl.load(y_ptr + offsets, mask=mask)\n"
"    tl.store(output_ptr + offsets, x + y, mask=mask)\n"
"\n"
"\n"
"def make_ttir(kernel, signature, constants):\n"
"    source = ASTSource(kernel, signature, constants, attrs=None)\n"
"    target = GPUTarget(\"npu\", \"\", 32)\n"
"    backend = make_backend(target)\n"
"\n"
"    options = backend.parse_options(\n"
"        {\n"
"            \"num_warps\": 8,\n"
"            \"num_stages\": 2,\n"
"            \"debug\": False,\n"
"            \"multibuffer\": False,\n"
"            \"compile_mode\": \"simd\",\n"
"            **source.parse_options(),\n"
"        }\n"
"    )\n"
"\n"
"    context = ir.context()\n"
"    ir.load_dialects(context)\n"
"    ascend_ir.load_dialects(context)\n"
"    return str(ast_to_ttir(kernel, source, context, options, {}, {}))\n"
"\n"
"\n"
"signature = {\n"
"    \"x_ptr\": \"*fp32\",\n"
"    \"y_ptr\": \"*fp32\",\n"
"    \"output_ptr\": \"*fp32\",\n"
"    \"n_elements\": \"i32\",\n"
"}\n"
"n_elements = 98432\n"
"configs = [\n"
"    {\"name\": \"block256\", \"BLOCK_SIZE\": 256},\n"
"    {\"name\": \"block1024\", \"BLOCK_SIZE\": 1024},\n"
"    {\"name\": \"block2048\", \"BLOCK_SIZE\": 2048},\n"
"]\n"
"\n"
"items = []\n"
"for cfg in configs:\n"
"    ttir = make_ttir(add_kernel, signature, {\"BLOCK_SIZE\": cfg[\"BLOCK_SIZE\"]})\n"
"    items.append(\n"
"        {\n"
"            \"config\": cfg[\"name\"],\n"
"            \"ttir\": ttir,\n"
"            # n_elements 是 signature 中的第 4 个参数，对应 TTIR 里的 %arg3。\n"
"            # pid_x 给 tl.program_id(0) 一个静态估算值。\n"
"            \"arg_bindings\": f\"arg3={n_elements},pid_x=0\",\n"
"        }\n"
"    )\n"
"\n"
"latencies = {}\n"
"for item in items:\n"
"    config, latency_us = costmodel_bench(item)\n"
"    if config is not None:\n"
"        latencies[config] = latency_us\n"
"\n"
"for config, latency_us in sorted(latencies.items(), key=lambda item: item[1]):\n"
"    print(f\"{config}: {latency_us:.3f} us\")\n"
msgstr ""
"from __future__ import annotations\n"
"\n"
"import triton\n"
"import triton.language as tl\n"
"from triton.backends.ascend.runtime.costmodel_runtime import costmodel_bench\n"
"from triton.backends.compiler import GPUTarget\n"
"from triton.compiler import ASTSource\n"
"from triton.compiler.code_generator import ast_to_ttir\n"
"from triton.compiler.compiler import make_backend\n"
"from triton._C.libtriton import ir\n"
"from triton._C.libtriton.ascend import ir as ascend_ir\n"
"\n"
"\n"
"@triton.jit\n"
"def add_kernel(x_ptr, y_ptr, output_ptr, n_elements, BLOCK_SIZE: tl.constexpr):\n"
"    pid = tl.program_id(axis=0)\n"
"    offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n"
"    mask = offsets < n_elements\n"
"    x = tl.load(x_ptr + offsets, mask=mask)\n"
"    y = tl.load(y_ptr + offsets, mask=mask)\n"
"    tl.store(output_ptr + offsets, x + y, mask=mask)\n"
"\n"
"\n"
"def make_ttir(kernel, signature, constants):\n"
"    source = ASTSource(kernel, signature, constants, attrs=None)\n"
"    target = GPUTarget(\"npu\", \"\", 32)\n"
"    backend = make_backend(target)\n"
"\n"
"    options = backend.parse_options(\n"
"        {\n"
"            \"num_warps\": 8,\n"
"            \"num_stages\": 2,\n"
"            \"debug\": False,\n"
"            \"multibuffer\": False,\n"
"            \"compile_mode\": \"simd\",\n"
"            **source.parse_options(),\n"
"        }\n"
"    )\n"
"\n"
"    context = ir.context()\n"
"    ir.load_dialects(context)\n"
"    ascend_ir.load_dialects(context)\n"
"    return str(ast_to_ttir(kernel, source, context, options, {}, {}))\n"
"\n"
"\n"
"signature = {\n"
"    \"x_ptr\": \"*fp32\",\n"
"    \"y_ptr\": \"*fp32\",\n"
"    \"output_ptr\": \"*fp32\",\n"
"    \"n_elements\": \"i32\",\n"
"}\n"
"n_elements = 98432\n"
"configs = [\n"
"    {\"name\": \"block256\", \"BLOCK_SIZE\": 256},\n"
"    {\"name\": \"block1024\", \"BLOCK_SIZE\": 1024},\n"
"    {\"name\": \"block2048\", \"BLOCK_SIZE\": 2048},\n"
"]\n"
"\n"
"items = []\n"
"for cfg in configs:\n"
"    ttir = make_ttir(add_kernel, signature, {\"BLOCK_SIZE\": cfg[\"BLOCK_SIZE\"]})\n"
"    items.append(\n"
"        {\n"
"            \"config\": cfg[\"name\"],\n"
"            \"ttir\": ttir,\n"
"            # n_elements is the 4th parameter in the signature, corresponding to %arg3 in the TTIR.\n"
"            # pid_x provides a static estimated value for tl.program_id(0).\n"
"            \"arg_bindings\": f\"arg3={n_elements},pid_x=0\",\n"
"        }\n"
"    )\n"
"\n"
"latencies = {}\n"
"for item in items:\n"
"    config, latency_us = costmodel_bench(item)\n"
"    if config is not None:\n"
"        latencies[config] = latency_us\n"
"\n"
"for config, latency_us in sorted(latencies.items(), key=lambda item: item[1]):\n"
"    print(f\"{config}: {latency_us:.3f} us\")\n"

msgid "TTIR 示例"
msgstr "TTIR Example"

msgid "调用 `make_ttir` 生成的 TTIR 示例（截取关键部分）："
msgstr "Example of the TTIR generated by calling `make_ttir` (key parts excerpted):"

msgid ""
"#(\"/usr/local/lib/python3.11/site-packages/triton/language/standard.py\":433:9-433:14)\n"
"module {\n"
"  tt.func public @add_kernel(%arg0: !tt.ptr<f32> {tt.divisibility = 32 : i32}, ...) -> !tt.ptr<f32> {\n"
"    %c0 = arith.constant 0 : i32\n"
"    %0 = tt.get_program_id x : i32\n"
"    %1 = arith.muli %0, %c1024_i32 : i32\n"
"    %2 = tt.make_range %arg3 end = 1024 : tensor<1024xi32>\n"
"    %3 = arith.addi %1, %2 : tensor<1024xi32>\n"
"    ...\n"
"    tt.store %arg2, %7, %6 : !tt.ptr<f32>\n"
"    tt.return\n"
"  }\n"
"}\n"
msgstr ""
"#(\"/usr/local/lib/python3.11/site-packages/triton/language/standard.py\":433:9-433:14)\n"
"module {\n"
"  tt.func public @add_kernel(%arg0: !tt.ptr<f32> {tt.divisibility = 32 : i32}, ...) -> !tt.ptr<f32> {\n"
"    %c0 = arith.constant 0 : i32\n"
"    %0 = tt.get_program_id x : i32\n"
"    %1 = arith.muli %0, %c1024_i32 : i32\n"
"    %2 = tt.make_range %arg3 end = 1024 : tensor<1024xi32>\n"
"    %3 = arith.addi %1, %2 : tensor<1024xi32>\n"
"    ...\n"
"    tt.store %arg2, %7, %6 : !tt.ptr<f32>\n"
"    tt.return\n"
"  }\n"
"}\n"

msgid "输出结果"
msgstr "Output Result"

msgid "不同版本的 costmodel 参数可能会使具体数值略有不同，但输出结构类似："
msgstr "Different versions of the costmodel parameters may result in slightly different specific values, but the output structure is similar:"

msgid ""
"block256: 0.098 us\n"
"block1024: 0.110 us\n"
"block2048: 0.126 us\n"
msgstr ""
"block256: 0.098 us\n"
"block1024: 0.110 us\n"
"block2048: 0.126 us\n"

msgid "`costmodel_bench` 每次评估一个 item，返回 `(config, latency_us)`。上层 autotune 逻辑可以逐个调用并汇总成字典，再按预测耗时排序，优先保留预测更快的 config。"
msgstr "`costmodel_bench` evaluates one item at a time and returns `(config, latency_us)`. The upper-layer autotune logic can call it one by one, aggregate the results into a dictionary, sort by predicted latency, and prioritize retaining the configs with faster predicted performance."

msgid "关键点说明"
msgstr "Key Points Description"

msgid "`ASTSource + ast_to_ttir` 只生成 TTIR，不会真实编译或启动 kernel。"
msgstr "`ASTSource + ast_to_ttir` only generates TTIR and does not actually compile or launch the kernel."

msgid "`config` 会影响 `tl.constexpr`，例如 `BLOCK_SIZE`，因此每个候选 config 都需要生成各自的 TTIR。"
msgstr "The `config` affects `tl.constexpr`, for example, `BLOCK_SIZE`. Therefore, each candidate config must generate its own TTIR."

msgid "`costmodel_bench` 每次只接收一个 item。该 item 至少包含 `config` 和 `ttir`，也可以附带 `arg_bindings`。"
msgstr "`costmodel_bench` accepts only one item at a time. The item must contain at least `config` and `ttir`, and can also include `arg_bindings`."

msgid "`arg_bindings` 用于把运行时整数参数绑定到 TTIR 中的 `%argN`。例如本例中 `n_elements=98432` 对应 `arg3=98432`。"
msgstr "`arg_bindings` binds runtime integer arguments to `%argN` in TTIR. For example, `n_elements=98432` corresponds to `arg3=98432` in this example."

msgid "如果 kernel 中使用 `tl.program_id(0)`，通常需要传入 `pid_x=0`。如果还使用 `tl.num_programs(0)`，可额外传入 `num_programs_x=...`。"
msgstr "If you use `tl.program_id(0)` in the kernel, you typically need to pass `pid_x=0`. If you also use `tl.num_programs(0)`, you can additionally pass `num_programs_x=...`."
