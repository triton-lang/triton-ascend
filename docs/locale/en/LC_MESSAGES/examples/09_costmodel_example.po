msgid "Costmodel端到端示例"
msgstr "Costmodel end-to-end sample"

msgid "本示例展示costmodel后端的基本调用流程："
msgstr "This sample demonstrates the basic invocation flow of the costmodel backend:"

msgid "使用Triton前端Kernel生成TTIR；"
msgstr "Use the Triton frontend kernel to generate TTIR;"

msgid "为多个候选config构造 `costmodel_bench` item；"
msgstr "Construct a `costmodel_bench` item for multiple candidate configurations;"

msgid "对每个item调用一次 `costmodel_bench`，并汇总每个config的预测耗时。"
msgstr "Call `costmodel_bench` once for each item, and aggregate the predicted latency of each config."

msgid "这个流程适合在autotune前快速筛掉预计性能较差的config。示例只使用向量加法Kernel，便于聚焦costmodel的输入和返回值。"
msgstr "This process is suitable for quickly filtering out configurations with poor expected performance before autotune. The sample uses only the vector addition kernel to focus on the inputs and return values of the costmodel."

msgid "完整示例"
msgstr "Complete sample"

msgid "将下面的代码保存为 `costmodel_example.py` 后运行："
msgstr "Save the following code as `costmodel_example.py` and run it:"

msgid ""
"from __future__ import annotations\n"
"\n"
"import triton\n"
"import triton.language as tl\n"
"from triton.backends.ascend.runtime.costmodel_runtime import costmodel_bench\n"
"from triton.backends.compiler import GPUTarget\n"
"from triton.compiler import ASTSource\n"
"from triton.compiler.code_generator import ast_to_ttir\n"
"from triton.compiler.compiler import make_backend\n"
"from triton._C.libtriton import ir\n"
"from triton._C.libtriton.ascend import ir as ascend_ir\n"
"\n"
"\n"
"@triton.jit\n"
"def add_kernel(x_ptr, y_ptr, output_ptr, n_elements, BLOCK_SIZE: tl.constexpr):\n"
"    pid = tl.program_id(axis=0)\n"
"    offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n"
"    mask = offsets < n_elements\n"
"    x = tl.load(x_ptr + offsets, mask=mask)\n"
"    y = tl.load(y_ptr + offsets, mask=mask)\n"
"    tl.store(output_ptr + offsets, x + y, mask=mask)\n"
"\n"
"\n"
"def make_ttir(kernel, signature, constants):\n"
"    source = ASTSource(kernel, signature, constants, attrs=None)\n"
"    target = GPUTarget(\"npu\", \"\", 32)\n"
"    backend = make_backend(target)\n"
"\n"
"    options = backend.parse_options(\n"
"        {\n"
"            # num_warps=8 表示每个 CTA 使用 8 个 warp；num_stages 控制流水级数；multibuffer 关闭多缓冲；compile_mode 指定 simd 编译模式，上述选项共同决定生成 TTIR 的结果与预测耗时\n"
"            \"num_warps\": 8,\n"
"            \"num_stages\": 2,\n"
"            \"debug\": False,\n"
"            \"multibuffer\": False,\n"
"            \"compile_mode\": \"simd\",\n"
"            **source.parse_options(),\n"
"        }\n"
"    )\n"
"\n"
"    context = ir.context()\n"
"    ir.load_dialects(context)\n"
"    ascend_ir.load_dialects(context)\n"
"    return str(ast_to_ttir(kernel, source, context, options, {}, {}))\n"
"\n"
"\n"
"signature = {\n"
"    \"x_ptr\": \"*fp32\",\n"
"    \"y_ptr\": \"*fp32\",\n"
"    \"output_ptr\": \"*fp32\",\n"
"    \"n_elements\": \"i32\",\n"
"}\n"
"n_elements = 98432\n"
"configs = [\n"
"    {\"name\": \"block256\", \"BLOCK_SIZE\": 256},\n"
"    {\"name\": \"block1024\", \"BLOCK_SIZE\": 1024},\n"
"    {\"name\": \"block2048\", \"BLOCK_SIZE\": 2048},\n"
"]\n"
"\n"
"items = []\n"
"for cfg in configs:\n"
"    ttir = make_ttir(add_kernel, signature, {\"BLOCK_SIZE\": cfg[\"BLOCK_SIZE\"]})\n"
"    items.append(\n"
"        {\n"
"            \"config\": cfg[\"name\"],\n"
"            \"ttir\": ttir,\n"
"            # n_elements是signature中的第4个参数，对应TTIR里的 %arg3。\n"
"            # pid_x给tl.program_id(0) 一个静态估算值。\n"
"            \"arg_bindings\": f\"arg3={n_elements},pid_x=0\",\n"
"        }\n"
"    )\n"
"\n"
"latencies = {}\n"
"for item in items:\n"
"    config, latency_us = costmodel_bench(item)\n"
"    if config is not None:\n"
"        latencies[config] = latency_us\n"
"\n"
"for config, latency_us in sorted(latencies.items(), key=lambda item: item[1]):\n"
"    print(f\"{config}: {latency_us:.3f} us\")\n"
msgstr ""
"from __future__ import annotations\n"
"\n"
"import triton\n"
"import triton.language as tl\n"
"from triton.backends.ascend.runtime.costmodel_runtime import costmodel_bench\n"
"from triton.backends.compiler import GPUTarget\n"
"from triton.compiler import ASTSource\n"
"from triton.compiler.code_generator import ast_to_ttir\n"
"from triton.compiler.compiler import make_backend\n"
"from triton._C.libtriton import ir\n"
"from triton._C.libtriton.ascend import ir as ascend_ir\n"
"\n"
"\n"
"@triton.jit\n"
"def add_kernel(x_ptr, y_ptr, output_ptr, n_elements, BLOCK_SIZE: tl.constexpr):\n"
"    pid = tl.program_id(axis=0)\n"
"    offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n"
"    mask = offsets < n_elements\n"
"    x = tl.load(x_ptr + offsets, mask=mask)\n"
"    y = tl.load(y_ptr + offsets, mask=mask)\n"
"    tl.store(output_ptr + offsets, x + y, mask=mask)\n"
"\n"
"\n"
"def make_ttir(kernel, signature, constants):\n"
"    source = ASTSource(kernel, signature, constants, attrs=None)\n"
"    target = GPUTarget(\"npu\", \"\", 32)\n"
"    backend = make_backend(target)\n"
"\n"
"    options = backend.parse_options(\n"
"        {\n"
"            # num_warps=8 indicates that each CTA uses 8 warps; num_stages controls the number of pipeline stages; multibuffer disables multi-buffering; compile_mode specifies the simd compilation mode. These options together determine the generated TTIR result and the predicted latency.\n"
"            \"num_warps\": 8,\n"
"            \"num_stages\": 2,\n"
"            \"debug\": False,\n"
"            \"multibuffer\": False,\n"
"            \"compile_mode\": \"simd\",\n"
"            **source.parse_options(),\n"
"        }\n"
"    )\n"
"\n"
"    context = ir.context()\n"
"    ir.load_dialects(context)\n"
"    ascend_ir.load_dialects(context)\n"
"    return str(ast_to_ttir(kernel, source, context, options, {}, {}))\n"
"\n"
"\n"
"signature = {\n"
"    \"x_ptr\": \"*fp32\",\n"
"    \"y_ptr\": \"*fp32\",\n"
"    \"output_ptr\": \"*fp32\",\n"
"    \"n_elements\": \"i32\",\n"
"}\n"
"n_elements = 98432\n"
"configs = [\n"
"    {\"name\": \"block256\", \"BLOCK_SIZE\": 256},\n"
"    {\"name\": \"block1024\", \"BLOCK_SIZE\": 1024},\n"
"    {\"name\": \"block2048\", \"BLOCK_SIZE\": 2048},\n"
"]\n"
"\n"
"items = []\n"
"for cfg in configs:\n"
"    ttir = make_ttir(add_kernel, signature, {\"BLOCK_SIZE\": cfg[\"BLOCK_SIZE\"]})\n"
"    items.append(\n"
"        {\n"
"            \"config\": cfg[\"name\"],\n"
"            \"ttir\": ttir,\n"
"            # n_elements is the fourth parameter in signature, corresponding to %arg3 in the TTIR.\n"
"            # pid_x provides a static estimated value for tl.program_id(0).\n"
"            \"arg_bindings\": f\"arg3={n_elements},pid_x=0\",\n"
"        }\n"
"    )\n"
"\n"
"latencies = {}\n"
"for item in items:\n"
"    config, latency_us = costmodel_bench(item)\n"
"    if config is not None:\n"
"        latencies[config] = latency_us\n"
"\n"
"for config, latency_us in sorted(latencies.items(), key=lambda item: item[1]):\n"
"    print(f\"{config}: {latency_us:.3f} us\")\n"

