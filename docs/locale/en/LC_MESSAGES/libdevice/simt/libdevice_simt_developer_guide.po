msgid "计算输入参数的反正切值。"
msgstr "Computes the inverse tangent (arctan) of the input parameter."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:190
msgid "返回值: `tl.tensor`, 返回输入参数的反正切值，取值范围 \\[-π/2, π/2] 弧度。"
msgstr ""
"Return Value: `tl.tensor`, containing the inverse tangent of the input"
"parameter, in the range [-π/2, π/2] radians."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:194
msgid "12. triton.language.extra.cann.libdevice.atan2"
msgstr "12. triton.language.extra.cann.atan2"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:198
msgid "反正切函数，计算 x / y 的反正切值。"
msgstr "Two-argument inverse tangent function, computes the arctangent of x / y."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:206
msgid "返回值: `tl.tensor`, 返回 x / y 的反正切值，取值范围 \\[-π, π] 弧度。"
msgstr ""
"Return Value: `tl.tensor`, containing the arctangent of x / y, in the"
"range [-π, π] radians."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:210
msgid "13. triton.language.extra.cann.libdevice.atanh"
msgstr "13. triton.language.extra.cann.atanh"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:214
msgid "反双曲正切函数，计算输入参数的反双曲正切值。"
msgstr "Inverse hyperbolic tangent function, computes the inverse hyperbolic tangent of the input parameter."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:222
msgid "返回值: `tl.tensor`, 返回输入参数的反双曲正切值，取值范围 \\[-1, 1]。"
msgstr ""
"Return Value: `tl.tensor`, containing the inverse hyperbolic tangent of"
"the input parameter, in the range [-1, 1]."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:226
msgid "14. triton.language.extra.cann.libdevice.brev"
msgstr "14. triton.language.extra.cann.brev"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:230
msgid "位反转函数，反转32位整数的位顺序。"
msgstr "Bit reversal function, reverses the bit order of a 32-bit integer."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:238
msgid "返回值: `tl.tensor`, 返回位反转后的32位整数。"
msgstr "Return Value: `tl.tensor`, containing the 32-bit integer with reversed bit order."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:240
#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:270
#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:302
#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:574
#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:814
#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:894
#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:942
msgid "支持类型：`int32`"
msgstr "Supported Datatypes: `int32`"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:242
msgid "15. triton.language.extra.cann.libdevice.byte_perm"
msgstr "15. triton.language.extra.cann.byte_perm"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:252
msgid "字节排列操作，从两个32位整数中选择字节组成新整数。输入整数 x 和 y 的字节顺序如下"
msgstr "Byte permutation operation, selects bytes from two 32-bit integers to form a new integer. The byte order of input integers x and y is as follows:"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:261
msgid "字节选择参数 s 为32位整数，各比特位与字节选择对应关系如下"
msgstr "The byte selection parameter s is a 32-bit integer, with each bit group corresponding to byte selection as follows:"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:268
msgid ""
"返回值: `tl.tensor`, 返回值 return\\[n] := input\\[selector\\[n]]，n 表示输出整数的第 n "
"个字节。"
msgstr ""
"Return Value: `tl.tensor`, where return[n] := input[selector[n]], where"
"n represents the n-th byte of the output integer."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:272
msgid "16. triton.language.extra.cann.libdevice.ceil"
msgstr "16. triton.language.extra.cann.ceil"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:276
msgid "向上取整，返回大于或等于 x 的最小整数。"
msgstr "Ceiling operation, returns the smallest integer greater than or equal to x."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:284
msgid "返回值: `tl.tensor`, 返回向上取整的结果。"
msgstr "Return Value: `tl.tensor`, containing the ceiling result."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:288
msgid "17. triton.language.extra.cann.libdevice.clz"
msgstr "17. triton.language.extra.cann.clz"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:292
msgid "计算32位整数的前导零数量。"
msgstr "Counts the number of leading zeros in a 32-bit integer."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:300
msgid "返回值: `tl.tensor`, 返回输入参数的前导零数量。范围 \\[0, 32]。"
msgstr ""
"Return Value: `tl.tensor`, containing the number of leading zeros in the"
"input parameter. Range: [0, 32]."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:304
msgid "18. triton.language.extra.cann.libdevice.copysign"
msgstr "18. triton.language.extra.cann.copysign"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:308
msgid "生成一个浮点数，其绝对值等于 x 的绝对值，符号与 y 相同。"
msgstr "Generates a floating-point number with magnitude equal to the magnitude of x and sign equal to the sign of y."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:316
msgid "返回值: `tl.tensor`, 返回一个浮点数，其绝对值等于 x 的绝对值，符号与 y 相同。"
msgstr "Return Value: `tl.tensor`, containing a floating-point number with magnitude equal to the magnitude of x and sign equal to the sign of y."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:320
msgid "19. triton.language.extra.cann.libdevice.cos"
msgstr "19. triton.language.extra.cann.cos"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:324
msgid "计算输入参数（弧度）的余弦值。"
msgstr "Computes the cosine of the input parameter (in radians)."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:332
msgid "返回值: `tl.tensor`, 返回输入参数的余弦值。"
msgstr "Return Value: `tl.tensor`, containing the cosine of the input parameter."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:336
msgid "20. triton.language.extra.cann.libdevice.cosh"
msgstr "20. triton.language.extra.cann.cosh"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:340
msgid "计算输入参数的双曲余弦值。"
msgstr "Computes the hyperbolic cosine of the input parameter."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:348
msgid "返回值: `tl.tensor`, 返回输入参数的双曲余弦值。"
msgstr "Return Value: `tl.tensor`, containing the hyperbolic cosine of the input parameter."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:352
msgid "21. triton.language.extra.cann.libdevice.cyl_bessel_i0"
msgstr "21. triton.language.extra.cann.cyl_bessel_i0"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:356
msgid "计算输入参数的修正零阶贝塞尔函数值。"
msgstr "Computes the modified Bessel function of the first kind of order zero for the input parameter."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:364
msgid "返回值: `tl.tensor`, 返回输入参数的修正零阶贝塞尔函数值。"
msgstr "Return Value: `tl.tensor`, containing the modified Bessel function of the first kind of order zero for the input parameter."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:368
msgid "22. triton.language.extra.cann.libdevice.div_rd"
msgstr "22. triton.language.extra.cann.div_rd"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:372
msgid "向下舍入浮点数除法。"
msgstr "Floating-point division with round-down (toward negative infinity) rounding mode."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:380
#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:396
#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:412
#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:428
msgid "返回值: `tl.tensor`, 返回除法结果。"
msgstr "Return Value: `tl.tensor`, containing the division result."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:384
msgid "23. triton.language.extra.cann.libdevice.div_rn"
msgstr "23. triton.language.extra.cann.div_rn"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:388
msgid "最近偶数舍入浮点数除法。"
msgstr "Floating-point division with round-to-nearest-even rounding mode."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:400
msgid "24. triton.language.extra.cann.libdevice.div_ru"
msgstr "24. triton.language.extra.cann.div_ru"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:404
msgid "向上舍入浮点数除法。"
msgstr "Floating-point division with round-up (toward positive infinity) rounding mode."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:414
msgid "支持类型：`float32` |"
msgstr "Supported Datatypes: `float32`"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:416
msgid "25. triton.language.extra.cann.libdevice.div_rz"
msgstr "25. triton.language.extra.cann.div_rz"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:420
msgid "向零舍入浮点数除法。"
msgstr "Floating-point division with round-toward-zero rounding mode."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:432
msgid "26. triton.language.extra.cann.libdevice.erfinv"
msgstr "26. triton.language.extra.cann.erfinv"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:436
msgid "逆误差函数，找到满足 x = erf(y) 的值 y。"
msgstr "Inverse error function, finds the value y such that x = erf(y)."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:444
msgid "返回值: `tl.tensor`, 返回输入参数的逆误差函数值。"
msgstr "Return Value: `tl.tensor`, containing the inverse error function of the input parameter."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:448
msgid "27. triton.language.extra.cann.libdevice.exp10"
msgstr "27. triton.language.extra.cann.exp10"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:452
msgid "以 10 为底的指数函数，计算 10 的 x 次方。"
msgstr "Base-10 exponential function, computes 10 raised to the power of x."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:460
msgid "返回值: `tl.tensor`, 返回 10 的 x 次方的计算结果。"
msgstr "Return Value: `tl.tensor`, containing the result of 10 raised to the power of x."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:464
msgid "29. triton.language.extra.cann.libdevice.exp2"
msgstr "29. triton.language.extra.cann.exp2"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:468
msgid "以 2 为底的指数函数，计算 2 的 x 次方。"
msgstr "Base-2 exponential function, computes 2 raised to the power of x."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:476
msgid "返回值: `tl.tensor`, 返回 2 的 x 次方的计算结果。"
msgstr "Return Value: `tl.tensor`, containing the result of 2 raised to the power of x."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:480
msgid "30. triton.language.extra.cann.libdevice.exp"
msgstr "30. triton.language.extra.cann.exp"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:484
msgid "指数函数，计算 e 的 x 次方。"
msgstr "Exponential function, computes e raised to the power of x."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:492
msgid "返回值: `tl.tensor`, 返回 e 的 x 次方的计算结果。"
msgstr "Return Value: `tl.tensor`, containing the result of e raised to the power of x."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:496
msgid "30. triton.language.extra.cann.libdevice.expm1"
msgstr "30. triton.language.extra.cann.expm1"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:500
msgid "计算 e 的 x 次方减 1 的结果。"
msgstr "Computes e raised to the power of x, minus 1."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:508
msgid "返回值: `tl.tensor`, 返回 e 的 x 次方减 1 的计算结果。"
msgstr "Return Value: `tl.tensor`, containing the result of e raised to the power of x, minus 1."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:512
msgid "31. triton.language.extra.cann.libdevice.fast_dividef"
msgstr "31. triton.language.extra.cann.fast_dividef"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:516
msgid "快速近似除法。"
msgstr "Fast approximate division."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:524
msgid "返回值: `tl.tensor`, 返回快速近似除法的结果。"
msgstr "Return Value: `tl.tensor`, containing the result of the fast approximate division."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:528
msgid "32. triton.language.extra.cann.libdevice.fast_expf"
msgstr "32. triton.language.extra.cann.fast_expf"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:532
msgid "快速近似指数函数。"
msgstr "Fast approximate exponential function."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:540
msgid "返回值: `tl.tensor`, 返回快速近似指数函数的结果。"
msgstr "Return Value: `tl.tensor`, containing the result of the fast approximate exponential function."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:544
msgid "33. triton.language.extra.cann.libdevice.fdim"
msgstr "33. triton.language.extra.cann.fdim"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:548
msgid "计算 x 与 y 的正差。当 x > y 时，返回 x - y，否则返回 0。"
msgstr "Computes the positive difference between x and y. When x > y, returns x - y; otherwise returns 0."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:556
msgid "返回值: `tl.tensor`, 返回 x 与 y 之间的正差。"
msgstr "Return Value: `tl.tensor`, containing the positive difference between x and y."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:560
msgid "34. triton.language.extra.cann.libdevice.ffs"
msgstr "34. triton.language.extra.cann.ffs"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:564
msgid "查找第一个被置为1的位，返回最低被置为1的位的索引。"
msgstr "Finds the first bit set to 1, returns the index of the lowest bit set to 1."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:572
msgid "返回值: `tl.tensor`, 返回最低被置为1的位的索引，取值范围 \\[0, 32]。"
msgstr "Return Value: `tl.tensor`, containing the result of fused multiply-add."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:576
msgid "35. triton.language.extra.cann.libdevice.float_as_int"
msgstr "35. triton.language.extra.cann.float_as_int"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:580
msgid "将浮点数的比特位重新解释为32位整数。不进行数值转换。"
msgstr "Reinterprets the bit pattern of a floating-point number as a 32-bit integer. No numeric conversion is performed."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:588
msgid "返回值: `tl.tensor`, 返回将浮点数的比特位重新解释为32位整数的结果。"
msgstr "Return Value: `tl.tensor`, containing the bit pattern of the floating-point number reinterpreted as a 32-bit integer."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:592
msgid "36. triton.language.extra.cann.libdevice.floor"
msgstr "36. triton.language.extra.cann.floor"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:596
msgid "向下取整，返回小于或等于 x 的最大整数。"
msgstr "Floor operation, returns the largest integer less than or equal to x."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:604
msgid "返回值: `tl.tensor`, 返回向下取整的结果。"
msgstr "Return Value: `tl.tensor`, containing the floor result."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:608
msgid "37. triton.language.extra.cann.libdevice.fma"
msgstr "37. triton.language.extra.cann.fma"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:612
msgid "融合乘加，计算 x × y + z。"
msgstr "Fused multiply-add, computes x * y + z."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:620
#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:636
#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:652
#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:668
#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:684
msgid "返回值: `tl.tensor`, 返回融合乘加的结果。"
msgstr "Return Value: `tl.tensor`, containing the result of fused multiply-add."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:624
msgid "38. triton.language.extra.cann.libdevice.fma_rd"
msgstr "38. triton.language.extra.cann.fma_rd"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:628
msgid "向下舍入模式下的融合乘加操作。"
msgstr "Fused multiply-add operation with round-down rounding mode."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:640
msgid "39. triton.language.extra.cann.libdevice.fma_rn"
msgstr "39. triton.language.extra.cann.fma_rn"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:644
msgid "最近偶数舍入模式下的融合乘加操作。"
msgstr "Fused multiply-add operation with round-to-nearest-even rounding mode."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:656
msgid "40. triton.language.extra.cann.libdevice.fma_ru"
msgstr "40. triton.language.extra.cann.fma_ru"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:660
msgid "向上舍入模式下的融合乘加操作。"
msgstr "Fused multiply-add operation with round-up rounding mode."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:672
msgid "41. triton.language.extra.cann.libdevice.fma_rz"
msgstr "41. triton.language.extra.cann.fma_rz"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:676
msgid "向零舍入模式下的融合乘加操作。"
msgstr "Fused multiply-add operation with round-toward-zero rounding mode."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:688
msgid "42. triton.language.extra.cann.libdevice.fmod"
msgstr "42. triton.language.extra.cann.fmod"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:692
msgid "浮点数取模，计算 x / y 的余数，结果与 x 同号。"
msgstr "Floating-point modulo, computes the remainder of x / y, with the same sign as x."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:700
msgid "返回值: `tl.tensor`, 返回浮点数取模的结果。"
msgstr "Return Value: `tl.tensor`, containing the result of the floating-point modulo."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:704
msgid "43. triton.language.extra.cann.libdevice.hadd"
msgstr "43. triton.language.extra.cann.hadd"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:708
msgid "计算 x 和 y 的平均值。"
msgstr "Computes the average of x and y."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:716
msgid "返回值: `tl.tensor`, 返回 x 和 y 的平均值。"
msgstr "Return Value: `tl.tensor`, containing the average of x and y."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:720
msgid "44. triton.language.extra.cann.libdevice.hypot"
msgstr "44. triton.language.extra.cann.hypot"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:724
msgid "计算 x 和 y 之间的欧几里得距离。"
msgstr "Computes the Euclidean distance between x and y."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:732
msgid "返回值: `tl.tensor`, 返回 x 和 y 之间的欧几里得距离。"
msgstr "Return Value: `tl.tensor`, containing the Euclidean distance between x and y."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:736
msgid "45. triton.language.extra.cann.libdevice.lgamma"
msgstr "45. triton.language.extra.cann.lgamma"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:740
msgid "计算输入为 x 的伽马函数绝对值的自然对数。"
msgstr "Computes the natural logarithm of the absolute value of the gamma function for input x."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:748
msgid "返回值: `tl.tensor`, 返回输入为 x 的伽马函数绝对值的自然对数。"
msgstr "Return Value: `tl.tensor`, containing the natural logarithm of the absolute value of the gamma function for input x."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:752
msgid "46. triton.language.extra.cann.libdevice.log10"
msgstr "46. triton.language.extra.cann.log10"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:756
msgid "计算输入为 x 的以 10 为底的对数。"
msgstr "Computes the base-10 logarithm of input x."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:764
msgid "返回值: `tl.tensor`, 返回输入为 x 的以 10 为底的对数。"
msgstr "Return Value: `tl.tensor`, containing the base-10 logarithm of input x."

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:768
msgid "47. triton.language.extra.cann.libdevice.log2"
msgstr "47. triton.language.extra.cann.log2"

#: ../../zh/libdevice/simt/libdevice_simt_developer_guide.md:772
msgid "计算输入为 x 的以 2 为底的对数。"
