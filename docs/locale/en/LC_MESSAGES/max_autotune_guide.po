"    key=[\"M\", \"N\"],\n"
"    kernel_type=\"vector\",\n"
"    num_stages=[1, 2],\n"
")\n"
"@triton.jit\n"
"def kernel(...):\n"
"    ...\n"
msgstr ""
"@max_autotune(\n"
"    configs=[triton.Config(kwargs={'BLOCK_M': 128}, num_stages=2)],\n"
"    key=[\"M\", \"N\"],\n"
"    kernel_type=\"vector\",\n"
"    num_stages=[1, 2],\n"
")\n"
"@triton.jit\n"
"def kernel(...):\n"
"    ...\n"

msgid "展开过程："
msgstr "Expansion process:"

msgid "`kernel_type=\"vector\"` 支持的参数为 `num_stages` 和 `enable_ubuf_saving`；"
msgstr "`kernel_type=\"vector\"` supports the parameters `num_stages` and `enable_ubuf_saving`;"

msgid "`num_stages` 在 `tuning_params` 中提供 `[1, 2]`，优先级最高；"
msgstr "`num_stages` is provided in `tuning_params` as `[1, 2]`, with the highest priority;"

msgid "`enable_ubuf_saving` 未提供，使用默认值 `[True]`；"
msgstr "`enable_ubuf_saving` is not provided, and the default value `[True]` is used;"

msgid "笛卡尔积展开后得到 2 个配置。"
msgstr "Expanding the Cartesian product yields two configurations."

msgid "展开结果等效于："
msgstr "The expanded result is equivalent to:"

msgid ""
"configs=[\n"
"    triton.Config(kwargs={'BLOCK_M': 128, 'enable_ubuf_saving': True}, num_stages=1),\n"
"    triton.Config(kwargs={'BLOCK_M': 128, 'enable_ubuf_saving': True}, num_stages=2),\n"
"]\n"
msgstr ""
"configs=[\n"
"    triton.Config(kwargs={'BLOCK_M': 128, 'enable_ubuf_saving': True}, num_stages=1),\n"
"    triton.Config(kwargs={'BLOCK_M': 128, 'enable_ubuf_saving': True}, num_stages=2),\n"
"]\n"

msgid "在基础配置中固定参数"
msgstr "Fix the parameters in the basic configuration"

msgid "如果希望某个调优参数不参与展开，可以在基础配置中直接固定："
msgstr "If you want to exclude a tuning parameter from the expansion, fix it directly in the base configuration:"

msgid ""
"@max_autotune(\n"
"    configs=[\n"
"        triton.Config(kwargs={'BLOCK_M': 128, 'enable_ubuf_saving': False}),\n"
"    ],\n"
"    key=[\"M\", \"N\"],\n"
"    kernel_type=\"vector\",\n"
"    num_stages=[1, 2],\n"
"    # enable_ubuf_saving 已在基础配置中固定为 False，不会使用默认值 [True]\n"
")\n"
"@triton.jit\n"
"def kernel(...):\n"
"    ...\n"
msgstr ""
"@max_autotune(\n"
"    configs=[\n"
"        triton.Config(kwargs={'BLOCK_M': 128, 'enable_ubuf_saving': False}),\n"
"    ],\n"
"    key=[\"M\", \"N\"],\n"
"    kernel_type=\"vector\",\n"
"    num_stages=[1, 2],\n"
"    # enable_ubuf_saving is fixed to False in the base configuration, and the default value [True] is not used.\n"
")\n"
"@triton.jit\n"
"def kernel(...):\n"
"    ...\n"

msgid "使用注意事项"
msgstr "Usage Precautions"

msgid "1. 不支持的参数会被忽略"
msgstr "1\\. Unsupported parameters are ignored."

msgid "如果通过 `tuning_params` 传递了当前 `kernel_type` 不支持的参数，会产生警告并忽略该参数："
msgstr "If you pass a parameter that is not supported by the current `kernel_type` through `tuning_params`, a warning is generated and the parameter is ignored:"

msgid ""
"# 警告：tile_mix_vector_loop 不支持 kernel_type=\"vector\"\n"
"@max_autotune(\n"
"    configs=[...],\n"
"    key=[\"M\"],\n"
"    kernel_type=\"vector\",\n"
"    tile_mix_vector_loop=[2, 4],  # 将被忽略并产生警告\n"
")\n"
"@triton.jit\n"
"def kernel(...):\n"
"    ...\n"
msgstr ""
"# Warning: tile_mix_vector_loop does not support kernel_type=\"vector\"\n"
"@max_autotune(\n"
"    configs=[...],\n"
"    key=[\"M\"],\n"
"    kernel_type=\"vector\",\n"
"    tile_mix_vector_loop=[2, 4],  # Will be ignored, and a warning will be generated\n"
")\n"
"@triton.jit\n"
"def kernel(...):\n"
"    ...\n"

msgid "2. 参数值必须是列表"
msgstr "2\\. The parameter value must be a list."

msgid "`tuning_params` 中的每个值必须是列表或元组，且不能为空："
msgstr "Each value in `tuning_params` must be a list or a tuple, and cannot be empty:"

msgid ""
"# 正确写法\n"
"enable_hivm_auto_cv_balance=[True, False]\n"
"\n"
"# 错误写法：不是列表\n"
"enable_hivm_auto_cv_balance=True  # 将导致验证错误\n"
msgstr ""
"# Correct usage\n"
"enable_hivm_auto_cv_balance=[True, False]\n"
"\n"
"# Incorrect usage: not a list\n"
"enable_hivm_auto_cv_balance=True  # This will cause a validation error\n"

msgid "3. 配置数量增长"
msgstr "3\\. Increase in the number of configurations"

msgid "展开后的配置数量等于： 基础配置数量 × Π(每个 tuning_param 的列表长度)"
msgstr "The number of expanded configurations equals: the base configuration count × Π(the list length of each tuning_param)"

msgid "例如，2 个基础配置 × 3 个参数（列表长度分别为 2、3、2）= 12 个展开配置。"
msgstr "For example, 2 base configurations × 3 parameters (with list lengths of 2, 3, and 2 respectively) = 12 expanded configurations."

msgid "过多的配置会增加首次调优时间，建议根据实际需要合理控制参数空间。"
msgstr "Excessive configurations increase the initial tuning time. Control the parameter space based on your actual needs."

msgid "4. 与 `configs=[]` 的区别"
msgstr "4\\. Differences from `configs=[]`"

msgid "`max_autotune` 与 `@triton.autotune(configs=[], ...)` 是两种不同的自动调优策略："
msgstr "`max_autotune` and `@triton.autotune(configs=[], ...)` are two different autotune strategies:"

