"    kernel_type=\"mix\",\n"
"    num_stages=[1, 2],\n"
"    enable_hivm_auto_cv_balance=[True, False],\n"
"    tile_mix_vector_loop=[2, 4, 8],\n"
"    tile_mix_cube_loop=[2, 4],\n"
")\n"
"@triton.jit\n"
"def mixed_kernel(...):\n"
"    ...\n"
msgstr ""
"@max_autotune(\n"
"    configs=[\n"
"        triton.Config(kwargs={'BLOCK_M': 64, 'BLOCK_N': 64}),\n"
"        triton.Config(kwargs={'BLOCK_M': 128, 'BLOCK_N': 128}),\n"
"    ],\n"
"    key=[\"M\", \"N\", \"K\"],\n"
"    kernel_type=\"mix\",\n"
"    num_stages=[1, 2],\n"
"    enable_hivm_auto_cv_balance=[True, False],\n"
"    tile_mix_vector_loop=[2, 4, 8],\n"
"    tile_mix_cube_loop=[2, 4],\n"
")\n"
"@triton.jit\n"
"def mixed_kernel(...):\n"
"    ...\n"

msgid "展开后配置数量计算："
msgstr "Configuration count calculation after expansion:"

msgid "用户提供的参数：`num_stages`（2）、`enable_hivm_auto_cv_balance`（2）、`tile_mix_vector_loop`（3）、`tile_mix_cube_loop`（2）"
msgstr "Parameters provided by the user: `num_stages` (2), `enable_hivm_auto_cv_balance` (2), `tile_mix_vector_loop` (3), `tile_mix_cube_loop` (2)"

msgid "使用默认值的参数：`set_workspace_multibuffer`（默认 `[2, 4]` → 2）、其他参数各 1"
msgstr "Parameters using default values: `set_workspace_multibuffer` (default `[2, 4]` → 2), and other parameters each 1"

msgid "总配置数量：`2 × 2 × 2 × 2 × 3 × 2 = 96` 个配置。"
msgstr "Total number of configurations: `2 × 2 × 2 × 2 × 3 × 2 = 96` configurations."

msgid "2. 针对 cube 类型算子的调优"
msgstr "2\\. Tuning for cube-type operators"

msgid "cube 类型算子（如纯矩阵乘法）支持的参数较少："
msgstr "Cube operators (such as pure matrix multiplication) support fewer parameters:"

msgid ""
"@max_autotune(\n"
"    configs=[\n"
"        triton.Config(kwargs={'BLOCK_M': 128, 'BLOCK_N': 128, 'BLOCK_K': 32}),\n"
"    ],\n"
"    key=[\"M\", \"N\", \"K\"],\n"
"    kernel_type=\"cube\",\n"
"    num_stages=[1, 2],\n"
"    unit_flag=[True, False],\n"
"    limit_auto_multi_buffer_of_local_buffer=[\"no-limit\", \"no-l0c\"],\n"
")\n"
"@triton.jit\n"
"def matmul_kernel(...):\n"
"    ...\n"
msgstr ""
"@max_autotune(\n"
"    configs=[\n"
"        triton.Config(kwargs={'BLOCK_M': 128, 'BLOCK_N': 128, 'BLOCK_K': 32}),\n"
"    ],\n"
"    key=[\"M\", \"N\", \"K\"],\n"
"    kernel_type=\"cube\",\n"
"    num_stages=[1, 2],\n"
"    unit_flag=[True, False],\n"
"    limit_auto_multi_buffer_of_local_buffer=[\"no-limit\", \"no-l0c\"],\n"
")\n"
"@triton.jit\n"
"def matmul_kernel(...):\n"
