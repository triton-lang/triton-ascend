msgid "配置workspace multi-buffer档位，用于为workspace相关数据搬运启用多缓冲。"
msgstr "Configure the workspace multi-buffer level to enable multi-buffering for workspace-related data movement."

msgid "默认None；可取单个值，如2或4。autotune中可配置候选值"
msgstr "Defaults to None; can be set to a single value, for example, 2 or 4. Candidate values can be configured in autotune."

msgid "enable_hivm_auto_cv_balance"
msgstr "enable_hivm_auto_cv_balance"

msgid "启用或禁用自动CV balance，用于在CV融合场景下平衡Cube与Vector执行。"
msgstr "Enable or disable automatic CV balance to balance Cube and Vector execution in CV fusion scenarios."

msgid "tile_mix_vector_loop"
msgstr "tile_mix_vector_loop"

msgid "CV算子的一个优化项，当前Vector可以切几份"
msgstr "An optimization item for CV operators: how many parts the Vector can currently be split into"

msgid "默认None；可取单个值，如2、4或8。autotune中可配置候选值"
msgstr "Defaults to None; can take a single value, for example, 2, 4, or 8. Candidate values can be configured in autotune."

msgid "tile_mix_cube_loop"
msgstr "tile_mix_cube_loop"

msgid "CV算子一个优化项，当前Cube可以切几份"
msgstr "An optimization item for CV operators: the Cube can currently be split into several parts"

msgid "注：优化编译选项位于 `third_party/ascend/backend/compiler.py`。"
msgstr "Note: The optimization compilation options are located in `third_party/ascend/backend/compiler.py`."

msgid "注：CV算子表示该算子运算过程中既使用了AI Core又使用了Vector Core。"
msgstr "Note: A CV operator indicates that both the AI Core and the Vector Core are used during its computation."

msgid "注：当前有效编译选项及废弃名称的迁移方式见 {ref}`编译选项清理与兼容性 <compiler-option-cleanup-and-compatibility>`。"
msgstr "Note: For the migration methods of currently valid compilation options and deprecated names, refer to {ref}`Compilation Option Cleanup and Compatibility <compiler-option-cleanup-and-compatibility>`."
