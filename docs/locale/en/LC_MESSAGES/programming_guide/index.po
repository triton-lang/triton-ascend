msgstr "aiv_mte2_time(μs)"

msgid "aiv_mte2_ratio"
msgstr "aiv_mte2_ratio"

msgid "未优化"
msgstr "Unoptimized"

msgid "pick_kernel"
msgstr "pick_kernel"

