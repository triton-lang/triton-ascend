#, fuzzy
msgid ""
msgstr ""#: ../../zh/triton_api/Creation_Ops/cast.md:1
msgid "triton.language.cast"
msgstr "triton.language.cast"

#: ../../zh/triton_api/Creation_Ops/cast.md:3
msgid "1 功能作用说明"
msgstr "1. Function Description"

#: ../../zh/triton_api/Creation_Ops/cast.md:5
msgid "将张量转换为指定的数据类型，支持数值类型转换、位级别重解释（bitcast）、浮点降精度舍入模式，以及Ascend扩展的整数溢出处理模式。"
msgstr ""
"Converts the tensor to the specified data type, supporting numeric type "
"conversion, bit-level reinterpretation (bitcast), floating-point downcast "
"rounding mode, and Ascend extension integer overflow handling mode."

#: ../../zh/triton_api/Creation_Ops/cast.md:7
msgid "**语法：**"
msgstr "**Syntax:**"

#: ../../zh/triton_api/Creation_Ops/cast.md:9
msgid ""
"`triton.language.cast(input, dtype, fp_downcast_rounding=None, "
"bitcast=False, overflow_mode=None)` - 函数调用形式"
msgstr ""
"`triton.language.cast(input, dtype, fp_downcast_rounding=None, "
"bitcast=False, overflow_mode=None)` - function call form"

#: ../../zh/triton_api/Creation_Ops/cast.md:10
msgid ""
"`input.cast(dtype, fp_downcast_rounding=None, bitcast=False, "
"overflow_mode=None)` - 成员函数形式"
msgstr ""
"`input.cast(dtype, fp_downcast_rounding=None, bitcast=False, "
"overflow_mode=None)` - member function form"

#: ../../zh/triton_api/Creation_Ops/cast.md:12
msgid "**功能：**"
msgstr "**Function:**"

#: ../../zh/triton_api/Creation_Ops/cast.md:14
msgid "数值类型转换：整型<->整型、浮点<->浮点、整型<->浮点"
msgstr ""
"Numeric type conversion: integer<->integer, float<->float, integer<->float"

#: ../../zh/triton_api/Creation_Ops/cast.md:15
msgid "位级别重解释（bitcast）：不改变比特，只改变解释类型"
msgstr ""
"Bit-level reinterpretation (bitcast): does not change bits, only changes the"
" interpretation type"

#: ../../zh/triton_api/Creation_Ops/cast.md:16
msgid "浮点降精度支持舍入模式：`rtne`（默认，四舍六入五成双）、`rtz`（向零）"
msgstr ""
"Floating-point downcast supports rounding modes: `rtne` (default, round to "
"nearest even), `rtz` (toward zero)"

#: ../../zh/triton_api/Creation_Ops/cast.md:17
msgid "整数转换（Ascend 扩展）支持溢出模式：`trunc`（截断，默认）、`saturate`（饱和）"
msgstr ""
"Integer conversion (Ascend extension) supports overflow modes: `trunc` "
"(truncate, default), `saturate` (saturate)"

