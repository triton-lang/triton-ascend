#: ../../zh/triton_api_extension/al/copy_from_ub_to_l1.md:40
msgid "无"
msgstr "None"

#: ../../zh/triton_api_extension/al/copy_from_ub_to_l1.md:42
msgid "3. 约束说明"
msgstr "3\. Constraints"

#: ../../zh/triton_api_extension/al/copy_from_ub_to_l1.md:44
msgid "src 和 dst 必须同时为 tensor 或者 buffer ，tensor 暂时不支持"
msgstr ""
"`src` and `dst` must both be `tensor` or `buffer`; `tensor` is not"
"supported for now"

#: ../../zh/triton_api_extension/al/copy_from_ub_to_l1.md:46
msgid "src 的address space 必须为UB， dst 的address space 必须为L1"
msgstr ""
"The address space of `src` must be UB, and the address space of `dst`"
"must be L1"

#: ../../zh/triton_api_extension/al/copy_from_ub_to_l1.md:48
msgid "src 和 dst 类型 ，形状必须相同"
msgstr "`src` and `dst` must have the same type and shape"

