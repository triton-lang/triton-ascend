#: ../../zh/triton_api_extension/al/scope.md:68
msgid ""
"each kernel have 1 scope for cube and vector, inside them they run "
"parallely and there are other syncing operations that declares the sync "
"between both of the scope"
msgstr ""
"each kernel have 1 scope for cube and vector, inside them they run"
"parallely and there are other syncing operations that declares the sync"
"between both of the scope"

#: ../../zh/triton_api_extension/al/scope.md:70
msgid ""
"Parallel Execution: Operations within cube and vector scopes execute in "
"parallel"
msgstr ""
"Parallel Execution: Operations within cube and vector scopes execute"
"in parallel"

#: ../../zh/triton_api_extension/al/scope.md:72
msgid ""
"Single Scope per Type: Each kernel supports one cube scope and one vector"
" scope (?)"
msgstr ""
"Single Scope per Type: Each kernel supports one cube scope and one"
"vector scope (?)"

#: ../../zh/triton_api_extension/al/scope.md:74
msgid ""
"Explicit Synchronization: Required for data dependencies between scopes "
"using sync operations"
msgstr ""
"Explicit Synchronization: Required for data dependencies between"
"scopes using sync operations"

