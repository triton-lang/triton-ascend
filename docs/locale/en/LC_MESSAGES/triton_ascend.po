msgstr "`pointer`"


msgid "`triton.PointerDType`"
msgstr "`triton.PointerDType`"


msgid "要操作的内存位置，执行 *pointer + val 计算后的结果写回到该内存"
msgstr ""
"The memory location to operate on; the result of *pointer + val is written "
"back to this memory"


msgid "`val`"
msgstr "`val`"


msgid "`pointer.dtype.element_ty`"
msgstr "`pointer.dtype.element_ty`"


