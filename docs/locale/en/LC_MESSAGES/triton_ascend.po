msgstr "Ceiling operation, returns the smallest integer greater than or equal to x."


msgid "返回值: `tl.tensor`, 返回向上取整的结果。"
msgstr "Return Value: `tl.tensor`, containing the ceiling result."


msgid "17. triton.language.extra.cann.libdevice.clz"
msgstr "17. triton.language.extra.cann.libdevice.clz"


msgid "计算32位整数的前导零数量。"
msgstr "Counts the number of leading zeros in a 32-bit integer."


