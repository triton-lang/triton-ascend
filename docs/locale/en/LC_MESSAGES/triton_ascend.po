msgstr "**Execution time**"


msgid "运行时（kernel 执行时）"
msgstr "Runtime (kernel execution)"


msgid "编译时（kernel 编译时）"
msgstr "Compilation (kernel compilation)"


msgid "**输出位置**"
msgstr "**Output location**"


