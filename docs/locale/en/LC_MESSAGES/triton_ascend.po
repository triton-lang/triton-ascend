msgid "1. triton.language.extra.cann.libdevice.abs"
msgstr "1. triton.language.extra.cann.libdevice.abs"


msgid "OP概述"
msgstr "OP Overview"


msgid "计算输入参数的绝对值。"
msgstr "Computes the absolute value of the input parameter."


msgid "原型:"
msgstr "Prototype:"


msgid "返回值: `tl.tensor`, 返回输入参数的绝对值。"
msgstr "Return Value: `tl.tensor`, containing the absolute value of the input parameter."


msgid "支持类型：`int32`, `float32`"
msgstr "Supported Datatypes: `int32`, `float32`"


msgid "3. triton.language.extra.cann.libdevice.acos"
msgstr "3. triton.language.extra.cann.libdevice.acos"


msgid "计算输入参数的反余弦值。"
msgstr "Computes the inverse cosine (arccos) of the input parameter."


msgid "返回值: `tl.tensor`, 返回输入参数的反余弦值，取值范围 \\[0, π] 弧度。"
msgstr ""
"Return Value: `tl.tensor`, containing the inverse cosine of the input"
"parameter, in the range [0, π] radians."


msgid "支持类型：`float32`"
msgstr "Supported Datatypes: `float32`"


msgid "4. triton.language.extra.cann.libdevice.acosh"
msgstr "4. triton.language.extra.cann.libdevice.acosh"


msgid "计算输入参数的反双曲余弦值。"
msgstr "Computes the inverse hyperbolic cosine of the input parameter."


msgid "返回值: `tl.tensor`, 返回输入参数的反双曲余弦值，取值范围 \\[0, +∞]。"
msgstr ""
"Return Value: `tl.tensor`, containing the inverse hyperbolic cosine of"
"the input parameter, in the range [0, +∞]."


msgid "5. triton.language.extra.cann.libdevice.add_rd"
msgstr "5. triton.language.extra.cann.libdevice.add_rd"


msgid "向下舍入浮点数加法。"
msgstr "Floating-point addition with round-down (toward negative infinity) rounding mode."


msgid "返回值: `tl.tensor`, 返回向下舍入的加法结果。"
msgstr "Return Value: `tl.tensor`, containing the addition result rounded down."


msgid "6. triton.language.extra.cann.libdevice.add_rn"
msgstr "6. triton.language.extra.cann.libdevice.add_rn"


msgid "最近偶数舍入浮点数加法。"
msgstr "Floating-point addition with round-to-nearest-even rounding mode."


msgid "返回值: `tl.tensor`, 返回最近偶数舍入的加法结果。"
msgstr "Return Value: `tl.tensor`, containing the addition result rounded to the nearest even number."


msgid "7. triton.language.extra.cann.libdevice.add_ru"
msgstr "7. triton.language.extra.cann.libdevice.add_ru"


msgid "向上舍入浮点数加法。"
msgstr "Floating-point addition with round-up (toward positive infinity) rounding mode."


msgid "返回值: `tl.tensor`, 返回向上舍入的加法结果。"
msgstr "Return Value: `tl.tensor`, containing the addition result rounded up."


msgid "8. triton.language.extra.cann.libdevice.add_rz"
msgstr "8. triton.language.extra.cann.libdevice.add_rz"


msgid "向零舍入浮点数加法。"
msgstr "Floating-point addition with round-toward-zero rounding mode."


msgid "返回值: `tl.tensor`, 返回向零舍入的加法结果。"
msgstr "Return Value: `tl.tensor`, containing the addition result rounded toward zero."


msgid "9. triton.language.extra.cann.libdevice.asin"
msgstr "9. triton.language.extra.cann.libdevice.asin"


msgid "计算输入参数的反正弦值。"
msgstr "Computes the inverse sine (arcsin) of the input parameter."


msgid "返回值: `tl.tensor`, 返回输入参数的反正弦值，取值范围 \\[-π/2, π/2] 弧度。"
msgstr ""
"Return Value: `tl.tensor`, containing the inverse sine of the input"
"parameter, in the range [-π/2, π/2] radians."


msgid "10. triton.language.extra.cann.libdevice.asinh"
msgstr "10. triton.language.extra.cann.libdevice.asinh"


msgid "计算输入参数的反双曲正弦值。"
msgstr "Computes the inverse hyperbolic sine of the input parameter."


msgid "返回值: `tl.tensor`, 返回输入参数的反双曲正弦值。"
msgstr "Return Value: `tl.tensor`, containing the inverse hyperbolic sine of the input parameter."


msgid "11. triton.language.extra.cann.libdevice.atan"
msgstr "11. triton.language.extra.cann.libdevice.atan"


msgid "计算输入参数的反正切值。"
msgstr "Computes the inverse tangent (arctan) of the input parameter."


msgid "返回值: `tl.tensor`, 返回输入参数的反正切值，取值范围 \\[-π/2, π/2] 弧度。"
msgstr ""
"Return Value: `tl.tensor`, containing the inverse tangent of the input"
"parameter, in the range [-π/2, π/2] radians."


