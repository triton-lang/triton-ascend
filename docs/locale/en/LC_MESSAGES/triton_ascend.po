msgid "triton.language.extra.ascend.libdevice.index_select_simd"
msgstr "triton.language.extra.ascend.libdevice.index_select_simd"


msgid "1 功能作用说明"
msgstr "1. Function Description"


msgid ""
"在非尾轴维度上并行 gather 多个索引，并以 tile 为单位将数据零拷贝地从全局内存（GM）直接搬运到统一缓冲区（UB）的正确位置。该操作等效于 "
"`torch.index_select` 的高性能实现，适用于嵌入层查找、稀疏索引访问等场景。"
msgstr ""
"Parallel gathers multiple indices on non-trailing dimensions and copies data"
" zero-copy from global memory (GM) directly to the correct position in the "
"unified buffer (UB) in tile units. This operation is equivalent to the high-"
"performance implementation of `torch.index_select`, suitable for embedding "
"layer lookup, sparse index access, and other scenarios."


msgid "**语法：**"
msgstr "**Syntax:**"


msgid ""
"`triton.language.extra.ascend.libdevice.index_select_simd(src, dim, index, "
"src_shape, src_offset, read_shape)`"
msgstr ""
"`triton.language.extra.ascend.libdevice.index_select_simd(src, dim, index, "
"src_shape, src_offset, read_shape)`"
msgid "**功能：**"
msgstr "**Function:**"


msgid "在源张量的指定维度上，根据索引数组批量读取数据"
msgstr ""
"Reads data in batches from the source tensor along the specified dimension "
"according to the index array"


msgid "支持指定读取区域的偏移和大小，实现灵活的切片"
msgstr ""
"Supports specifying the offset and size of the read region, enabling "
"flexible slicing"


msgid "零拷贝高效实现，直接从 GM 搬运到 UB"
msgstr "Efficient zero-copy implementation, directly transfers from GM to UB"


msgid "保持元素类型和编码方式不变"
msgstr "Keeps the element type and encoding unchanged"


msgid "**典型应用场景：**"
msgstr "**Typical Application Scenarios:**"


msgid "嵌入层（Embedding）查找：从大词汇表中根据 token ID 批量读取词向量"
msgstr ""
"Embedding layer lookup: Reads word vectors in batches from a large "
"vocabulary based on token IDs"


msgid "稀疏张量操作：根据稀疏索引访问密集张量的特定行"
msgstr ""
"Sparse tensor operations: Accesses specific rows of a dense tensor based on "
"sparse indices"


msgid "动态路由和注意力机制：根据动态计算的索引选择特定特征"
