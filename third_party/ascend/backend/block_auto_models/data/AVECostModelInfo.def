#ifndef AVE_COST_ENTRY
#error "Define AVE_COST_ENTRY before including AVECostModelInfo.def"
#endif

// AVE_COST_ENTRY(Operation, SourceType, ResultType, ExecInterval, ExecLatency,
//                ExecUnit)

// Arithmetic: floating-point variants issue every cycle; integer add/sub/mul
// variants issue every two cycles.
AVE_COST_ENTRY(VFAddOp, F16, F16, 1, 4, 2)
AVE_COST_ENTRY(VFAddOp, BF16, BF16, 1, 4, 2)
AVE_COST_ENTRY(VFAddOp, F32, F32, 1, 4, 2)
AVE_COST_ENTRY(VFAddOp, I8, I8, 2, 4, 2)
AVE_COST_ENTRY(VFAddOp, I16, I16, 2, 4, 2)
AVE_COST_ENTRY(VFAddOp, I32, I32, 2, 4, 2)
AVE_COST_ENTRY(VFAddsOp, F16, F16, 1, 4, 2)
AVE_COST_ENTRY(VFAddsOp, BF16, BF16, 1, 4, 2)
AVE_COST_ENTRY(VFAddsOp, F32, F32, 1, 4, 2)
AVE_COST_ENTRY(VFAddsOp, I8, I8, 2, 4, 2)
AVE_COST_ENTRY(VFAddsOp, I16, I16, 2, 4, 2)
AVE_COST_ENTRY(VFAddsOp, I32, I32, 2, 4, 2)
AVE_COST_ENTRY(VFSubOp, F16, F16, 1, 4, 2)
AVE_COST_ENTRY(VFSubOp, BF16, BF16, 1, 4, 2)
AVE_COST_ENTRY(VFSubOp, F32, F32, 1, 4, 2)
AVE_COST_ENTRY(VFSubOp, I8, I8, 2, 5, 2)
AVE_COST_ENTRY(VFSubOp, I16, I16, 2, 5, 2)
AVE_COST_ENTRY(VFSubOp, I32, I32, 2, 5, 2)
AVE_COST_ENTRY(VFMulOp, F16, F16, 1, 5, 2)
AVE_COST_ENTRY(VFMulOp, BF16, BF16, 1, 5, 2)
AVE_COST_ENTRY(VFMulOp, F32, F32, 1, 5, 2)
AVE_COST_ENTRY(VFMulOp, I16, I16, 2, 5, 2)
AVE_COST_ENTRY(VFMulOp, I32, I32, 2, 5, 2)
AVE_COST_ENTRY(VFMulsOp, F16, F16, 1, 5, 2)
AVE_COST_ENTRY(VFMulsOp, BF16, BF16, 1, 5, 2)
AVE_COST_ENTRY(VFMulsOp, F32, F32, 1, 5, 2)
AVE_COST_ENTRY(VFMulsOp, I16, I16, 2, 5, 2)
AVE_COST_ENTRY(VFMulsOp, I32, I32, 2, 5, 2)

// Min/max variants all issue every cycle on both slots.
AVE_COST_ENTRY(VFMaxOp, F16, F16, 1, 4, 2)
AVE_COST_ENTRY(VFMaxOp, BF16, BF16, 1, 4, 2)
AVE_COST_ENTRY(VFMaxOp, F32, F32, 1, 3, 2)
AVE_COST_ENTRY(VFMaxOp, I8, I8, 1, 3, 2)
AVE_COST_ENTRY(VFMaxOp, I16, I16, 1, 3, 2)
AVE_COST_ENTRY(VFMaxOp, I32, I32, 1, 3, 2)
AVE_COST_ENTRY(VFMaxsOp, F16, F16, 1, 4, 2)
AVE_COST_ENTRY(VFMaxsOp, BF16, BF16, 1, 4, 2)
AVE_COST_ENTRY(VFMaxsOp, F32, F32, 1, 3, 2)
AVE_COST_ENTRY(VFMaxsOp, I8, I8, 1, 3, 2)
AVE_COST_ENTRY(VFMaxsOp, I16, I16, 1, 3, 2)
AVE_COST_ENTRY(VFMaxsOp, I32, I32, 1, 3, 2)
AVE_COST_ENTRY(VFMinOp, F16, F16, 1, 4, 2)
AVE_COST_ENTRY(VFMinOp, BF16, BF16, 1, 4, 2)
AVE_COST_ENTRY(VFMinOp, F32, F32, 1, 3, 2)
AVE_COST_ENTRY(VFMinOp, I8, I8, 1, 3, 2)
AVE_COST_ENTRY(VFMinOp, I16, I16, 1, 3, 2)
AVE_COST_ENTRY(VFMinOp, I32, I32, 1, 3, 2)
AVE_COST_ENTRY(VFMinsOp, F16, F16, 1, 4, 2)
AVE_COST_ENTRY(VFMinsOp, BF16, BF16, 1, 4, 2)
AVE_COST_ENTRY(VFMinsOp, F32, F32, 1, 3, 2)
AVE_COST_ENTRY(VFMinsOp, I8, I8, 1, 3, 2)
AVE_COST_ENTRY(VFMinsOp, I16, I16, 1, 3, 2)
AVE_COST_ENTRY(VFMinsOp, I32, I32, 1, 3, 2)
AVE_COST_ENTRY(VMaxSIOp, I8, I8, 1, 3, 2)
AVE_COST_ENTRY(VMaxSIOp, I16, I16, 1, 3, 2)
AVE_COST_ENTRY(VMaxSIOp, I32, I32, 1, 3, 2)
AVE_COST_ENTRY(VMaxsSIOp, I8, I8, 1, 3, 2)
AVE_COST_ENTRY(VMaxsSIOp, I16, I16, 1, 3, 2)
AVE_COST_ENTRY(VMaxsSIOp, I32, I32, 1, 3, 2)
AVE_COST_ENTRY(VMinSIOp, I8, I8, 1, 3, 2)
AVE_COST_ENTRY(VMinSIOp, I16, I16, 1, 3, 2)
AVE_COST_ENTRY(VMinSIOp, I32, I32, 1, 3, 2)
AVE_COST_ENTRY(VMinsSIOp, I8, I8, 1, 3, 2)
AVE_COST_ENTRY(VMinsSIOp, I16, I16, 1, 3, 2)
AVE_COST_ENTRY(VMinsSIOp, I32, I32, 1, 3, 2)
AVE_COST_ENTRY(VMaxUIOp, I8, I8, 1, 3, 2)
AVE_COST_ENTRY(VMaxUIOp, I16, I16, 1, 3, 2)
AVE_COST_ENTRY(VMaxUIOp, I32, I32, 1, 3, 2)
AVE_COST_ENTRY(VMaxsUIOp, I8, I8, 1, 3, 2)
AVE_COST_ENTRY(VMaxsUIOp, I16, I16, 1, 3, 2)
AVE_COST_ENTRY(VMaxsUIOp, I32, I32, 1, 3, 2)
AVE_COST_ENTRY(VMinUIOp, I8, I8, 1, 3, 2)
AVE_COST_ENTRY(VMinUIOp, I16, I16, 1, 3, 2)
AVE_COST_ENTRY(VMinUIOp, I32, I32, 1, 3, 2)
AVE_COST_ENTRY(VMinsUIOp, I8, I8, 1, 3, 2)
AVE_COST_ENTRY(VMinsUIOp, I16, I16, 1, 3, 2)
AVE_COST_ENTRY(VMinsUIOp, I32, I32, 1, 3, 2)

// Unary and logical instructions whose integer and floating variants have
// different measured throughput.
AVE_COST_ENTRY(VFAbsOp, F16, F16, 1, 4, 2)
AVE_COST_ENTRY(VFAbsOp, F32, F32, 1, 4, 2)
AVE_COST_ENTRY(VFAbsOp, I8, I8, 2, 4, 2)
AVE_COST_ENTRY(VFAbsOp, I16, I16, 2, 4, 2)
AVE_COST_ENTRY(VFAbsOp, I32, I32, 2, 4, 2)
AVE_COST_ENTRY(VFNegOp, F16, F16, 1, 4, 2)
AVE_COST_ENTRY(VFNegOp, F32, F32, 1, 4, 2)
AVE_COST_ENTRY(VFNegOp, I8, I8, 2, 4, 2)
AVE_COST_ENTRY(VFNegOp, I16, I16, 2, 4, 2)
AVE_COST_ENTRY(VFNegOp, I32, I32, 2, 4, 2)
AVE_COST_ENTRY(VFAndOp, I8, I8, 1, 3, 2)
AVE_COST_ENTRY(VFAndOp, I16, I16, 1, 3, 2)
AVE_COST_ENTRY(VFAndOp, I32, I32, 1, 3, 2)
AVE_COST_ENTRY(VFOrOp, I8, I8, 1, 4, 2)
AVE_COST_ENTRY(VFOrOp, I16, I16, 1, 4, 2)
AVE_COST_ENTRY(VFOrOp, I32, I32, 1, 4, 2)
AVE_COST_ENTRY(VFXorOp, I8, I8, 1, 3, 2)
AVE_COST_ENTRY(VFXorOp, I16, I16, 1, 3, 2)
AVE_COST_ENTRY(VFXorOp, I32, I32, 1, 3, 2)
AVE_COST_ENTRY(VFNotOp, I8, I8, 1, 4, 2)
AVE_COST_ENTRY(VFNotOp, I16, I16, 1, 4, 2)
AVE_COST_ENTRY(VFNotOp, I32, I32, 1, 4, 2)
AVE_COST_ENTRY(VFReluOp, F16, F16, 1, 4, 2)
AVE_COST_ENTRY(VFReluOp, F32, F32, 1, 4, 2)
AVE_COST_ENTRY(VFReluOp, I32, I32, 1, 4, 2)
AVE_COST_ENTRY(VFAbsDiffOp, F16, F16, 1, 4, 2)
AVE_COST_ENTRY(VFAbsDiffOp, F32, F32, 1, 4, 2)
AVE_COST_ENTRY(VFSelectOp, F8E4M3FN, F8E4M3FN, 1, 4, 2)
AVE_COST_ENTRY(VFSelectOp, F8E5M2, F8E5M2, 1, 4, 2)
AVE_COST_ENTRY(VFSelectOp, F16, F16, 1, 4, 2)
AVE_COST_ENTRY(VFSelectOp, BF16, BF16, 1, 4, 2)
AVE_COST_ENTRY(VFSelectOp, F32, F32, 1, 3, 2)
AVE_COST_ENTRY(VFSelectOp, I8, I8, 1, 4, 2)
AVE_COST_ENTRY(VFSelectOp, I16, I16, 1, 4, 2)
AVE_COST_ENTRY(VFSelectOp, I32, I32, 1, 4, 2)

// Conversions are keyed by both source and destination. Normal
// F16/BF16<->F32 conversions issue every cycle, while FP8 and integer width
// conversions issue every two cycles.
AVE_COST_ENTRY(VFExtFOp, F16, F32, 1, 4, 2)
AVE_COST_ENTRY(VFExtFOp, BF16, F32, 1, 4, 2)
AVE_COST_ENTRY(VFExtFOp, F8E4M3FN, F32, 2, 4, 2)
AVE_COST_ENTRY(VFExtFOp, F8E5M2, F32, 2, 4, 2)
AVE_COST_ENTRY(VFTruncFOp, F32, F16, 1, 4, 2)
AVE_COST_ENTRY(VFTruncFOp, F32, BF16, 1, 4, 2)
AVE_COST_ENTRY(VFTruncFOp, F32, F8E4M3FN, 2, 4, 2)
AVE_COST_ENTRY(VFTruncFOp, F32, F8E5M2, 2, 4, 2)
AVE_COST_ENTRY(VFExtSIOp, I8, I16, 2, 3, 2)
AVE_COST_ENTRY(VFExtSIOp, I8, I32, 2, 3, 2)
AVE_COST_ENTRY(VFExtSIOp, I16, I32, 2, 3, 2)
// VFFusion treats arith.extui as free, but AVE emits a real VCVTII.
AVE_COST_ENTRY(VFExtUIOp, I8, I16, 2, 4, 2)
AVE_COST_ENTRY(VFExtUIOp, I8, I32, 2, 4, 2)
AVE_COST_ENTRY(VFExtUIOp, I16, I32, 2, 4, 2)
AVE_COST_ENTRY(VFTruncIOp, I16, I8, 2, 4, 2)
AVE_COST_ENTRY(VFTruncIOp, I32, I8, 2, 4, 2)
AVE_COST_ENTRY(VFTruncIOp, I32, I16, 2, 4, 2)

// Expensive floating-point instructions retain their previous latency.
AVE_COST_ENTRY(VFDivOp, F16, F16, 8, 19, 2)
AVE_COST_ENTRY(VFDivOp, F32, F32, 4, 14, 2)
AVE_COST_ENTRY(VFSqrtOp, F16, F16, 8, 19, 2)
AVE_COST_ENTRY(VFSqrtOp, F32, F32, 4, 14, 2)
AVE_COST_ENTRY(VFExpOp, F16, F16, 8, 18, 2)
AVE_COST_ENTRY(VFExpOp, F32, F32, 4, 13, 2)
AVE_COST_ENTRY(VFLnOp, F16, F16, 8, 15, 2)
AVE_COST_ENTRY(VFLnOp, F32, F32, 4, 15, 2)
AVE_COST_ENTRY(VFExpdifOp, F16, F32, 4, 4, 2)
AVE_COST_ENTRY(VFExpdifOp, F32, F32, 4, 4, 2)

// VINTLV/VDINTLV support all b8/b16/b32 forms. They issue every cycle, but
// only on ISSUE SLOT0, so execUnit is one. The target-confirmed latency is
// eight cycles.
AVE_COST_ENTRY(VFInterleaveOp, F8E4M3FN, F8E4M3FN, 1, 8, 1)
AVE_COST_ENTRY(VFInterleaveOp, F8E5M2, F8E5M2, 1, 8, 1)
AVE_COST_ENTRY(VFInterleaveOp, F16, F16, 1, 8, 1)
AVE_COST_ENTRY(VFInterleaveOp, BF16, BF16, 1, 8, 1)
AVE_COST_ENTRY(VFInterleaveOp, F32, F32, 1, 8, 1)
AVE_COST_ENTRY(VFInterleaveOp, I8, I8, 1, 8, 1)
AVE_COST_ENTRY(VFInterleaveOp, I16, I16, 1, 8, 1)
AVE_COST_ENTRY(VFInterleaveOp, I32, I32, 1, 8, 1)
AVE_COST_ENTRY(VFDeInterleaveOp, F8E4M3FN, F8E4M3FN, 1, 8, 1)
AVE_COST_ENTRY(VFDeInterleaveOp, F8E5M2, F8E5M2, 1, 8, 1)
AVE_COST_ENTRY(VFDeInterleaveOp, F16, F16, 1, 8, 1)
AVE_COST_ENTRY(VFDeInterleaveOp, BF16, BF16, 1, 8, 1)
AVE_COST_ENTRY(VFDeInterleaveOp, F32, F32, 1, 8, 1)
AVE_COST_ENTRY(VFDeInterleaveOp, I8, I8, 1, 8, 1)
AVE_COST_ENTRY(VFDeInterleaveOp, I16, I16, 1, 8, 1)
AVE_COST_ENTRY(VFDeInterleaveOp, I32, I32, 1, 8, 1)
