       -0.66723564323200768, 4.2558743176624126e-11, 8.9767657100581316e-12,
       1.118165322971332, 0.020699191316380889, 0.41989869510894839,
       0.0052996146738271228, 0.64684242545163229},
      {112.27138842176649, 0.39139177441300232, 0.22414554362057174,
       0.29671820119438447, -0.74768723169018458, 15.058207945111747,
       0.30830202178508576, 2.2562325187416823e-10, -1.0253706425672018e-10,
       -5.474825695376671, -0.15567502278124964, 0.63395373455190318,
       0.063898930139854385, 0.73897903489124817},
