      {131.45593052099659, 0.33006110984864778, 0.21850040012458122,
       0.29778680456615753, -0.67294400239211394, 14.301926408067992,
       1.6531085896437963, 1.3903440201968138e-11, 1.3710973235347634e-12,
       1.9692112318414023, 0.12434710256939935},
      {131.09649347677941, 0.34325885075837703, 0.2296486485716252,
