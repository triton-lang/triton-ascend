// Physical timing matrix for SIMD predicate operations on 64-lane i32 data.
// Build one mode per object with -DFIXED_MODE=N.  Every iteration has four
// logical steps so paired slopes have the same loop/control structure.
//
// Independent data chains:
//   0 add
//   1 add + select(fixed predicate)
//   2 add + compare + select
//   3/4/5 add + two compares + pand/por/pxor + select
// Dependent data chain (all four steps update a0):
//   6 add
//   7 add + select(fixed predicate)
//   8 add + compare + select
//   9/10/11 add + two compares + pand/por/pxor + select
// Two independent chains (a0, a1, a0, a1): modes 12..17 as above.
// Three independent chains (a0, a1, a2, a0): modes 18..23 as above.
#include "RegBase/VecUtils.h"
#include "Vector/VecUtils.h"
#include "Utils.h"

constexpr int W = 64;

template <typename T>
__simt_vf__ LAUNCH_BOUND(1024) __aiv__ __attribute__((always_inline)) static void
seed_vf(__gm__ T *gm, __ubuf__ T *ub) {
  int tid = threadIdx.y * 32 + threadIdx.x;
  if (tid < 5 * W)
    ub[tid] = gm[tid];
}

template <typename T>
__simt_vf__ LAUNCH_BOUND(1024) __aiv__ __attribute__((always_inline)) static void
readback_vf(__gm__ T *gm, __ubuf__ T *ub) {
  int tid = threadIdx.y * 32 + threadIdx.x;
  if (tid < W)
    gm[640 + tid] = ub[tid];
}

#define STEP_ADD(A) vadd(A, A, kk, m)
#define STEP_SELECT(A)                                                        \
  vadd(A, A, kk, m); vsel(A, A, z, pfix)
#define STEP_COMPARE(A, P)                                                    \
  vadd(A, A, kk, m); vcmps_lt(P, A, (int32_t)5000, m);                       \
  vsel(A, A, z, P)
#define STEP_PAND(A, P, Q, R)                                                 \
  vadd(A, A, kk, m); vcmps_lt(P, A, (int32_t)5000, m);                       \
  vcmps_gt(Q, A, (int32_t)3000, m); pand(R, P, Q, m); vsel(A, A, z, R)
#define STEP_POR(A, P, Q, R)                                                  \
  vadd(A, A, kk, m); vcmps_lt(P, A, (int32_t)2500, m);                       \
  vcmps_gt(Q, A, (int32_t)5000, m); por(R, P, Q, m); vsel(A, A, z, R)
#define STEP_PXOR(A, P, Q, R)                                                 \
  vadd(A, A, kk, m); vcmps_lt(P, A, (int32_t)5000, m);                       \
  vcmps_gt(Q, A, (int32_t)3000, m); pxor(R, P, Q, m); vsel(A, A, z, R)

extern "C" __global__ [aicore] void
measure(__gm__ long long *out, __gm__ int32_t *gm, int K, int unused0,
        int unused1, int iterations, int mode) {
#ifdef FIXED_MODE
  mode = FIXED_MODE;
#endif
  (void)unused0;
  (void)unused1;
  auto ib = reinterpret_cast<__ubuf__ int32_t *>(0);
  uint16_t iteration_count = (uint16_t)iterations;

  cce::async_invoke<seed_vf<int32_t>>(cce::dim3{32, 10, 1}, gm, ib);
  pipe_barrier(PIPE_ALL);
  pipe_barrier(PIPE_ALL);
  long long start = get_sys_cnt();
  for (int k = 0; k < K; ++k) {
    __VEC_SCOPE__ {
      uint32_t count = W;
      vector_bool m;
      CREATE_MASK_BY_SIZE(m, int32_t, count);
      VectorReg<int32_t> a0, a1, a2, a3, kk, z;
      vector_bool p0, p1, p2, p3;
      vector_bool q0, q1, q2, q3;
      vector_bool r0, r1, r2, r3, pfix;
      vlds(a0, ib + 0 * W, 0, NORM);
      vlds(a1, ib + 1 * W, 0, NORM);
      vlds(a2, ib + 2 * W, 0, NORM);
      vlds(a3, ib + 3 * W, 0, NORM);
      vlds(kk, ib + 4 * W, 0, NORM);
      vdup(z, (int32_t)2000, m, __cce_simd::MODE_ZEROING);
      vcmps_gt(pfix, kk, (int32_t)4, m);

      if (mode == 0) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_ADD(a0); STEP_ADD(a1); STEP_ADD(a2); STEP_ADD(a3);
        }
      } else if (mode == 1) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_SELECT(a0); STEP_SELECT(a1); STEP_SELECT(a2); STEP_SELECT(a3);
        }
      } else if (mode == 2) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_COMPARE(a0, p0); STEP_COMPARE(a1, p1);
          STEP_COMPARE(a2, p2); STEP_COMPARE(a3, p3);
        }
      } else if (mode == 3) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_PAND(a0, p0, q0, r0); STEP_PAND(a1, p1, q1, r1);
          STEP_PAND(a2, p2, q2, r2); STEP_PAND(a3, p3, q3, r3);
        }
      } else if (mode == 4) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_POR(a0, p0, q0, r0); STEP_POR(a1, p1, q1, r1);
          STEP_POR(a2, p2, q2, r2); STEP_POR(a3, p3, q3, r3);
        }
      } else if (mode == 5) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_PXOR(a0, p0, q0, r0); STEP_PXOR(a1, p1, q1, r1);
          STEP_PXOR(a2, p2, q2, r2); STEP_PXOR(a3, p3, q3, r3);
        }
      } else if (mode == 6) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_ADD(a0); STEP_ADD(a0); STEP_ADD(a0); STEP_ADD(a0);
        }
      } else if (mode == 7) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_SELECT(a0); STEP_SELECT(a0); STEP_SELECT(a0); STEP_SELECT(a0);
        }
      } else if (mode == 8) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_COMPARE(a0, p0); STEP_COMPARE(a0, p0);
          STEP_COMPARE(a0, p0); STEP_COMPARE(a0, p0);
        }
      } else if (mode == 9) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_PAND(a0, p0, q0, r0); STEP_PAND(a0, p0, q0, r0);
          STEP_PAND(a0, p0, q0, r0); STEP_PAND(a0, p0, q0, r0);
        }
      } else if (mode == 10) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_POR(a0, p0, q0, r0); STEP_POR(a0, p0, q0, r0);
          STEP_POR(a0, p0, q0, r0); STEP_POR(a0, p0, q0, r0);
        }
      } else if (mode == 11) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_PXOR(a0, p0, q0, r0); STEP_PXOR(a0, p0, q0, r0);
          STEP_PXOR(a0, p0, q0, r0); STEP_PXOR(a0, p0, q0, r0);
        }
      } else if (mode == 12) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_ADD(a0); STEP_ADD(a1); STEP_ADD(a0); STEP_ADD(a1);
        }
      } else if (mode == 13) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_SELECT(a0); STEP_SELECT(a1); STEP_SELECT(a0); STEP_SELECT(a1);
        }
      } else if (mode == 14) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_COMPARE(a0, p0); STEP_COMPARE(a1, p1);
          STEP_COMPARE(a0, p0); STEP_COMPARE(a1, p1);
        }
      } else if (mode == 15) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_PAND(a0, p0, q0, r0); STEP_PAND(a1, p1, q1, r1);
          STEP_PAND(a0, p0, q0, r0); STEP_PAND(a1, p1, q1, r1);
        }
      } else if (mode == 16) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_POR(a0, p0, q0, r0); STEP_POR(a1, p1, q1, r1);
          STEP_POR(a0, p0, q0, r0); STEP_POR(a1, p1, q1, r1);
        }
      } else if (mode == 17) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_PXOR(a0, p0, q0, r0); STEP_PXOR(a1, p1, q1, r1);
          STEP_PXOR(a0, p0, q0, r0); STEP_PXOR(a1, p1, q1, r1);
        }
      } else if (mode == 18) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_ADD(a0); STEP_ADD(a1); STEP_ADD(a2); STEP_ADD(a0);
        }
      } else if (mode == 19) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_SELECT(a0); STEP_SELECT(a1); STEP_SELECT(a2); STEP_SELECT(a0);
        }
      } else if (mode == 20) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_COMPARE(a0, p0); STEP_COMPARE(a1, p1);
          STEP_COMPARE(a2, p2); STEP_COMPARE(a0, p0);
        }
      } else if (mode == 21) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_PAND(a0, p0, q0, r0); STEP_PAND(a1, p1, q1, r1);
          STEP_PAND(a2, p2, q2, r2); STEP_PAND(a0, p0, q0, r0);
        }
      } else if (mode == 22) {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_POR(a0, p0, q0, r0); STEP_POR(a1, p1, q1, r1);
          STEP_POR(a2, p2, q2, r2); STEP_POR(a0, p0, q0, r0);
        }
      } else {
        for (uint16_t i = 0; i < iteration_count; ++i) {
          STEP_PXOR(a0, p0, q0, r0); STEP_PXOR(a1, p1, q1, r1);
          STEP_PXOR(a2, p2, q2, r2); STEP_PXOR(a0, p0, q0, r0);
        }
      }
      vsts(a0, ib + 0 * W, 0, NORM_B32, m);
      vsts(a1, ib + 1 * W, 0, NORM_B32, m);
      vsts(a2, ib + 2 * W, 0, NORM_B32, m);
      vsts(a3, ib + 3 * W, 0, NORM_B32, m);
    }
    pipe_barrier(PIPE_ALL);
  }
  long long stop = get_sys_cnt();
  pipe_barrier(PIPE_ALL);
  out[0] = stop - start;
  cce::async_invoke<readback_vf<int32_t>>(cce::dim3{32, 2, 1}, gm, ib);
  pipe_barrier(PIPE_ALL);
}
