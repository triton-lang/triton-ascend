// SIMT predicate-operation matrix. Build one object per mode with
// -DFIXED_MODE=N so the timed VF contains no runtime mode branch.
//
// Each iteration updates eight ring-coupled u32 states per thread:
//   0 add baseline
//   1 add + compare + select
//   2 add + two compares + and + select
//   3 add + two compares + or  + select
//   4 add + two compares + xor + select
#include "RegBase/VecUtils.h"
#include "Vector/VecUtils.h"
#include "Utils.h"

#ifndef FIXED_MODE
#error "build with -DFIXED_MODE=N"
#endif

#if FIXED_MODE < 0 || FIXED_MODE > 4
#error "FIXED_MODE must be 0..4"
#endif

using GT = uint32_t;

#if defined(__DAV_C310__)
template <typename T>
__simt_vf__ LAUNCH_BOUND(1024) __aiv__ __attribute__((always_inline)) static void
copy_vf(__gm__ T *gm, __ubuf__ T *ub) {
  int tid = threadIdx.y * 32 + threadIdx.x;
  gm[tid] = ub[tid];
}

__simt_vf__ LAUNCH_BOUND(1024) __aiv__ __attribute__((always_inline)) static void
predicate_vf(__ubuf__ GT *dst, int iters, GT t1, GT t2) {
  int lane = threadIdx.x;
  int warp = threadIdx.y;
  int tid = warp * 32 + lane;
  GT seed = (GT)(tid + 1);
#define INIT(J) ((GT)(seed + (GT)(1031u * (J))) * (GT)0x9e3779b9u)
  GT a0 = INIT(0), a1 = INIT(1), a2 = INIT(2), a3 = INIT(3);
  GT a4 = INIT(4), a5 = INIT(5), a6 = INIT(6), a7 = INIT(7);
#undef INIT
  const GT reset = 12345u;

#if FIXED_MODE == 0
#define NEXT(A, B) ((A) + (B))
#elif FIXED_MODE == 1
#define NEXT(A, B) ((A) < t1 ? (A) + (B) : reset)
#elif FIXED_MODE == 2
#define NEXT(A, B) ((((A) < t1) & ((B) < t2)) ? (A) + (B) : reset)
#elif FIXED_MODE == 3
#define NEXT(A, B) ((((A) < t1) | ((B) < t2)) ? (A) + (B) : reset)
#else
#define NEXT(A, B) ((((A) < t1) ^ ((B) < t2)) ? (A) + (B) : reset)
#endif

  for (int i = 0; i < iters; ++i) {
    GT n0 = NEXT(a0, a1), n1 = NEXT(a1, a2);
    GT n2 = NEXT(a2, a3), n3 = NEXT(a3, a4);
    GT n4 = NEXT(a4, a5), n5 = NEXT(a5, a6);
    GT n6 = NEXT(a6, a7), n7 = NEXT(a7, a0);
    a0 = n0; a1 = n1; a2 = n2; a3 = n3;
    a4 = n4; a5 = n5; a6 = n6; a7 = n7;
  }
#undef NEXT
  dst[tid] = a0;
}

extern "C" __global__ [aicore] void
measure(__gm__ long long *out, __gm__ GT *gm, int K, int iters, GT t1,
        GT t2, int unused) {
  auto ub = reinterpret_cast<__ubuf__ GT *>(0);
  (void)gm;
  (void)unused;
  pipe_barrier(PIPE_ALL);
  long long start = get_sys_cnt();
  for (int k = 0; k < K; ++k) {
    cce::async_invoke<predicate_vf>(cce::dim3{32, 32, 1}, ub, iters, t1, t2);
    pipe_barrier(PIPE_ALL);
  }
  long long stop = get_sys_cnt();
  pipe_barrier(PIPE_ALL);
  out[0] = stop - start;
}

extern "C" __global__ [aicore] void
verify(__gm__ long long *out, __gm__ GT *gm, int K, int iters, GT t1,
       GT t2, int unused) {
  auto ub = reinterpret_cast<__ubuf__ GT *>(0);
  (void)K;
  (void)unused;
  cce::async_invoke<predicate_vf>(cce::dim3{32, 32, 1}, ub, iters, t1, t2);
  pipe_barrier(PIPE_ALL);
  cce::async_invoke<copy_vf<GT>>(cce::dim3{32, 32, 1}, gm, ub);
  pipe_barrier(PIPE_ALL);
  out[0] = 0;
}
#else
extern "C" __global__ [aicore] void
measure(__gm__ long long *, __gm__ GT *, int, int, GT, GT, int) {}
extern "C" __global__ [aicore] void
verify(__gm__ long long *, __gm__ GT *, int, int, GT, GT, int) {}
#endif
