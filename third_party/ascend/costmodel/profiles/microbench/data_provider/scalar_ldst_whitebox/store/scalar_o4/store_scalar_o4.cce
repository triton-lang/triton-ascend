// scalar_ldst_whitebox/store/scalar_o4
// Four scalar store ops, same-line / diff-line:
//   simd_main_st_same_o4     p[0..3]      (one 64B line)
//   simd_main_st_diff_o4     p[0],p[16],p[32],p[48] (four 64B lines)
//   simt_st_uniform_same_o4  p[0..3]      (one 128B line, 32 threads uniform)
//   simt_st_uniform_diff_o4  p[0],p[32],p[64],p[96] (four 128B lines, 32 threads uniform)
// ABI: (out, gm, iters, mode); out[0] is only a sink, not part of the target ops.
#include "RegBase/VecUtils.h"
#include "Vector/VecUtils.h"
#include "Utils.h"

using DT = float;

extern "C" __global__ [aicore] void
simd_main_st_same_o4(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  volatile __gm__ DT* p = gm;
  p[0] = (DT)(0 + 1); p[1] = (DT)(1 + 1); p[2] = (DT)(2 + 1); p[3] = (DT)(3 + 1);
  out[0] = 0;
}

extern "C" __global__ [aicore] void
simd_main_st_diff_o4(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  volatile __gm__ DT* p = gm;
  p[0 * 16] = (DT)(0 + 1); p[1 * 16] = (DT)(1 + 1);
  p[2 * 16] = (DT)(2 + 1); p[3 * 16] = (DT)(3 + 1);
  out[0] = 0;
}

__simt_vf__ LAUNCH_BOUND(32) __aiv__ __attribute__((always_inline)) static void
simt_st_uniform_same_o4_core(__gm__ DT* gm) {
  volatile __gm__ DT* p = gm;
  p[0] = 1.0f; p[1] = 1.0f; p[2] = 1.0f; p[3] = 1.0f;
}

extern "C" __global__ [aicore] void
simt_st_uniform_same_o4(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  cce::async_invoke<simt_st_uniform_same_o4_core>(cce::dim3{32, 1, 1}, gm);
  out[0] = 0;
}

__simt_vf__ LAUNCH_BOUND(32) __aiv__ __attribute__((always_inline)) static void
simt_st_uniform_diff_o4_core(__gm__ DT* gm) {
  volatile __gm__ DT* p = gm;
  p[0 * 32] = 1.0f; p[1 * 32] = 1.0f; p[2 * 32] = 1.0f; p[3 * 32] = 1.0f;
}

extern "C" __global__ [aicore] void
simt_st_uniform_diff_o4(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  cce::async_invoke<simt_st_uniform_diff_o4_core>(cce::dim3{32, 1, 1}, gm);
  out[0] = 0;
}
