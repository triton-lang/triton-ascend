// Board marginal sys_cnt probes: each kernel loops REP times over a K-op sequence.
// ABI: (out, gm, base, reps). Host fits REP=4 vs REP=16 slope.
#include "RegBase/VecUtils.h"
#include "Vector/VecUtils.h"
#include "Utils.h"

using DT = float;
constexpr int REP_STRIDE = 1 << 14;   // 64 KiB / 4B = 16384 elements

extern "C" __global__ [aicore] void
m_loop_nop(__gm__ long long* out, __gm__ DT* gm, int base, int reps) {
  (void)gm; (void)base;
  pipe_barrier(PIPE_ALL);
  long long t0 = get_sys_cnt();
  DT acc = (DT)0;
  for (int r = 0; r < reps; ++r) {
    acc += (DT)1;
  }
  pipe_barrier(PIPE_ALL);
  long long t1 = get_sys_cnt();
  out[0] = t1 - t0;
  out[1] = (long long)acc;
}

__simt_vf__ LAUNCH_BOUND(32) __aiv__ __attribute__((always_inline)) static void
m_simt_nop_core(__gm__ DT* p, __ubuf__ DT* sink) {
  int lane = threadIdx.x;
  sink[lane] = (DT)0;
 (void)p;
}
extern "C" __global__ [aicore] void
m_loop_simt_nop(__gm__ long long* out, __gm__ DT* gm, int base, int reps) {
  (void)gm; (void)base;
  auto sink = reinterpret_cast<__ubuf__ DT*>(0);
  cce::async_invoke<m_simt_nop_core>(cce::dim3{32,1,1}, (__gm__ DT*)0, sink);
  pipe_barrier(PIPE_ALL);
  long long t0 = get_sys_cnt();
  for (int r = 0; r < reps; ++r) {
    cce::async_invoke<m_simt_nop_core>(cce::dim3{32,1,1}, (__gm__ DT*)0, sink);
  }
  pipe_barrier(PIPE_ALL);
  long long t1 = get_sys_cnt();
  out[0] = t1 - t0;
}

extern "C" __global__ [aicore] void
m_main_ld_same_k1(__gm__ long long* out, __gm__ DT* gm, int base, int reps) {
  volatile __gm__ DT* basep = gm + base;
  DT acc = (DT)0;
  pipe_barrier(PIPE_ALL);
  long long t0 = get_sys_cnt();
  for (int r = 0; r < reps; ++r) {
    volatile __gm__ DT* p = basep + r * REP_STRIDE;
    acc += p[0];
  }
  pipe_barrier(PIPE_ALL);
  long long t1 = get_sys_cnt();
  out[0] = t1 - t0;
  out[1] = (long long)(acc);
}

