__simt_vf__ LAUNCH_BOUND(32) __aiv__ __attribute__((always_inline)) static void
m_simt_ld_uni_same_k1_core(__gm__ DT* p, __ubuf__ DT* sink) {
  int lane = threadIdx.x;
  DT a0 = p[0];
  sink[lane] = (DT)(a0);
}

extern "C" __global__ [aicore] void
m_simt_ld_uni_same_k1(__gm__ long long* out, __gm__ DT* gm, int base, int reps) {
