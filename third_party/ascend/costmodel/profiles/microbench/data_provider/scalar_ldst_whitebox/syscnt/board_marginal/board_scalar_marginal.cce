  pipe_barrier(PIPE_ALL);
  long long t0 = get_sys_cnt();
  for (int r = 0; r < reps; ++r) {
    __gm__ DT* p = (__gm__ DT*)(basep + r * REP_STRIDE);
    cce::async_invoke<m_simt_ld_uni_same_k1_core>(cce::dim3{32,1,1}, p, sink);
  }
  pipe_barrier(PIPE_ALL);
