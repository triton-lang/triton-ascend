m_simt_ub_copy_k1_core(__ubuf__ DT* p, __ubuf__ DT* sink) {
  int lane = threadIdx.x;
  p[1024 + 0*32 + lane] = p[0*32 + lane];
}

extern "C" __global__ [aicore] void
m_simt_ub_copy_k1(__gm__ long long* out, __gm__ DT* gm, int base, int reps) {
  (void)gm; (void)base;
  auto sink = reinterpret_cast<__ubuf__ DT*>(0);
  for (int r = 0; r < reps; ++r) {
    __ubuf__ DT* p = reinterpret_cast<__ubuf__ DT*>((r * 4096));
    cce::async_invoke<m_simt_ub_copy_k1_core>(cce::dim3{32,1,1}, p, sink);
  }
  pipe_barrier(PIPE_ALL);
  long long t0 = get_sys_cnt();
  for (int r = 0; r < reps; ++r) {
    __ubuf__ DT* p = reinterpret_cast<__ubuf__ DT*>((r * 4096));
