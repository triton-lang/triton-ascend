{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_version",
    "target",
    "unit",
    "families"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_version": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "const": "syscnt_cycle"
    },
    "families": {
      "type": "object",
      "required": [
        "tail_axis"
      ],
      "additionalProperties": false,
      "properties": {
        "tail_axis": {
          "type": "object",
          "required": [
            "simd",
            "simt"
          ],
          "additionalProperties": false,
          "properties": {
            "simd": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number"
                }
              }
            },
            "simt": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}
