+static LogicalResult propagateDownMemrefSelect(arith::SelectOp select,
+                                               UnrealizedConversionCastOp down,
+                                               PatternRewriter &rewriter) {
+  Value oldValue = down.getResult(0);
+  Value newValue = down.getInputs()[0];
+  auto slicedType = dyn_cast<MemRefType>(newValue.getType());
+  if (!slicedType ||
+      (select.getTrueValue() != oldValue && select.getFalseValue() != oldValue))
+    return failure();
+  auto info = getTilingDimInfo(down);
+  rewriter.setInsertionPoint(select);
+  auto sliceAlternative = [&](Value value) -> Value {
+    if (value == oldValue)
+      return newValue;
+    if (auto otherDown = value.getDefiningOp<UnrealizedConversionCastOp>()) {
+      if (otherDown->hasAttr(kBubbleUpPropagateDown) &&
+          otherDown.getInputs()[0].getType() == slicedType) {
+        auto otherInfo = getTilingDimInfo(otherDown);
+        if (otherInfo.tilingDim == info.tilingDim &&
+            otherInfo.offset == info.offset && otherInfo.size == info.size)
+          return otherDown.getInputs()[0];
+      }
+    }
+    return createBubblePropagatorUpLink(value, slicedType, info.offset,
+                                        info.size, info.tilingDim, rewriter)
+        .getResult(0);
+  };
+  Value first = sliceAlternative(select.getTrueValue());
+  Value second = sliceAlternative(select.getFalseValue());
+  auto replacement = rewriter.create<arith::SelectOp>(
+      select.getLoc(), select.getCondition(), first, second);
+  replacement->setAttrs(select->getAttrs());
+  insertDownPropagators(select, replacement, info.offset, info.size,
+                        info.tilingDim, rewriter);
+  rewriter.eraseOp(select);
+  if (down->use_empty())
+    rewriter.eraseOp(down);
+  return success();
+}
