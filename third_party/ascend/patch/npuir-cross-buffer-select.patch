+// A selected destination has two allocation roots with the same physical
+// shape. Use their common type for split inference; propagateUpSelect then
+// pushes the split into both alternatives, including both TCB annotations.
+static std::optional<Operation *> traceFixpipeAlloc(Value value) {
+  if (auto root = traceDefOp<memref::AllocOp>(value))
+    return root;
+  if (auto select = value.getDefiningOp<arith::SelectOp>()) {
+    auto first = traceFixpipeAlloc(select.getTrueValue());
+    auto second = traceFixpipeAlloc(select.getFalseValue());
+    if (first && second &&
+        (*first)->getResult(0).getType() == (*second)->getResult(0).getType())
+      return first;
+    return std::nullopt;
+  }
+  if (auto *def = value.getDefiningOp()) {
+    if (auto view = dyn_cast<ViewLikeOpInterface>(def))
+      return traceFixpipeAlloc(view.getViewSource());
+    if (auto cast = dyn_cast<memref::MemorySpaceCastOp>(def))
+      return traceFixpipeAlloc(cast.getSource());
+  }
+  return std::nullopt;
+}
