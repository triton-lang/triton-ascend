+FailureOrCastVec
+propagateSelectMemRefType(RewriterBase &rewriter,
+                          UnrealizedConversionCastOp conversion,
+                          arith::SelectOp select) {
+  Value from = conversion.getResult(0);
+  Value to = conversion.getInputs()[0];
+  auto alignedType = dyn_cast<MemRefType>(to.getType());
+  if (!alignedType ||
+      (select.getTrueValue() != from && select.getFalseValue() != from))
+    return failure();
+  Type oldType = select.getType();
+  rewriter.setInsertionPoint(select);
+  auto alignAlternative = [&](Value value) -> Value {
+    if (value == from)
+      return to;
+    if (value.getType() == alignedType)
+      return value;
+    // Both roots receive the same align marks. The peer allocation is
+    // rewritten later; its producer/consumer UCC pair then cancels.
+    auto peer = rewriter.create<UnrealizedConversionCastOp>(select.getLoc(),
+                                                            alignedType, value);
+    peer->setAttr(propagateFailureName, rewriter.getUnitAttr());
+    return peer.getResult(0);
+  };
+  Value first = alignAlternative(select.getTrueValue());
+  Value second = alignAlternative(select.getFalseValue());
+  rewriter.modifyOpInPlace(select, [&]() {
+    select.getTrueValueMutable().assign(first);
+    select.getFalseValueMutable().assign(second);
+    select.getResult().setType(alignedType);
+  });
+  rewriter.setInsertionPointAfter(select);
+  auto result = rewriter.create<UnrealizedConversionCastOp>(
+      select.getLoc(), oldType, select.getResult());
+  rewriter.replaceAllUsesExcept(select.getResult(), result.getResult(0),
+                                result);
+  return UnrealizedCastOpVec{result};
+}
