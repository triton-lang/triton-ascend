diff --git a/third_party/proton/proton/ascend_perf_monitor.py b/third_party/proton/proton/ascend_perf_monitor.py
new file mode 100644
index 000000000..3ecab1c93
--- /dev/null
+++ b/third_party/proton/proton/ascend_perf_monitor.py
@@ -0,0 +1,237 @@
+"""Serialized Hardware sampling. The device ABI is supplied by CANN and the driver."""
+import ctypes as C
+import json
+import os
+from pathlib import Path
+import struct
+import threading
+import time
+import warnings
+
+_CHANNELS = range(11, 29)  # Six triplets: AIC, AIV0, AIV1.
+_MAX_BYTES = 64 << 20
+_MAX_RECORDS = (16 << 20) // 32
+
+
+def _decode(raw, clocks):
+    records = []
+    incomplete = 0
+    for channel, data in raw.items():
+        starts = {}
+        cycle = 0
+        tail = len(data) % 4
+        incomplete += bool(tail)
+        for delta, info in struct.iter_unpack("<HH", memoryview(data)[:len(data) - tail]):
+            pipe = info >> 12
+            if pipe not in (0, 1, 2, 3, 4, 5, 10, 15):
+                continue
+            cycle += delta
+            scope = info & 0x3ff
+            if pipe == 15 or not info & 0x400 or scope >= 0x188:
+                continue  # Status words and the protocol-v2 drain markers are not user scopes.
+            key = (pipe, scope)
+            if info & 0x800:
+                start = starts.pop(key, None)
+                if start is None:
+                    incomplete += 1
+                else:
+                    if len(records) >= _MAX_RECORDS:
+                        raise RuntimeError("Decoded record limit exceeded")
+                    clock = clocks[(channel - _CHANNELS.start) % 3 != 0]
+                    records.append((channel, pipe, scope, start, cycle, clock))
+            else:
+                incomplete += key in starts
+                starts[key] = cycle
+        incomplete += len(starts)
+    return records, incomplete
+
+
+class _CommandParams(C.Structure):
+    _fields_ = [("path_len", C.c_uint32), ("limit", C.c_uint32), ("data_len", C.c_uint32), ("path", C.c_char * 1024),
+                ("data", C.c_char * 4096)]
+
+
+class _Command(C.Structure):
+    _fields_ = [("switch", C.c_uint64), ("switch_hi", C.c_uint64), ("count", C.c_uint32), ("devices", C.c_uint32 * 64),
+                ("model", C.c_uint32), ("kind", C.c_uint32), ("cache", C.c_uint32), ("params", _CommandParams)]
+
+
+class _Start(C.Structure):
+    _fields_ = [("kind", C.c_int), ("period", C.c_uint), ("realtime", C.c_uint), ("config", C.c_void_p),
