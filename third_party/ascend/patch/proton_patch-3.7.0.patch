+void InstrumentationProfiler::recordInstrumentationEvents(
+    uint64_t functionId, const std::vector<std::array<uint64_t, 6>> &records) {
+  if (!runtime || runtime->getDeviceType() != DeviceType::NPU)
+    throw std::runtime_error(
+        "Instrumentation events require an active NPU instrumentation session");
+  auto &contexts = functionScopeIdContexts.at(functionId);
+  for (const auto &r : records) {
+    if (r[0] < 11 || r[0] > 28 || r[1] > 10 || r[4] < r[3] || r[5] == 0 ||
+        !contexts.count(r[2]))
+      throw std::runtime_error("Invalid instrumentation scope event");
+  }
+  auto device =
+      static_cast<uint64_t>(reinterpret_cast<uintptr_t>(runtime->getDevice()));
+  const auto &name = functionNames.at(functionId);
+  for (auto *data : getDataSet()) {
+    auto kernelEntry = data->addOp(name);
+    for (const auto &r : records) {
+      auto scopeEntry =
+          data->addOp(kernelEntry.phase, kernelEntry.id, contexts.at(r[2]));
+      auto duration = r[4] - r[3];
+      scopeEntry.upsertMetric(std::make_unique<CycleMetric>(
+          r[3], r[4], duration, static_cast<double>(duration), kernelEntry.id,
+          name + " [instrumentation capture " +
+              std::to_string(kernelEntry.id) + "]",
+          r[0], (r[0] - 11) / 3, r[1], device,
+          static_cast<uint64_t>(runtime->getDeviceType()), 0, 0, 0, 0,
+          static_cast<double>(r[5]), true));
+    }
+  }
+}
