# FileCheck contract for the primary NPU artifacts emitted by
# task_0201_ptsm_program_mapping_runner.py (tokens=4096).  It intentionally
# checks the cache-local production TTIR rather than a hand-written surrogate:
#
#   FileCheck task-0201-primary-npu-mapping.check --check-prefix=Q < Q.ttir
#   FileCheck task-0201-primary-npu-mapping.check --check-prefix=K < K.ttir

# Q: module attributes {hacc.grid_specialization = {grid_0 = 4096 : i64, grid_1 = 16 : i64, grid_2 = 1 : i64, rule_mask = 2560 : i64, version = 1 : i64}, hacc.independent_axis_tensorize, hacc.persistent_task_strip_mining, hacc.program_grid_transforms = {transforms = [{axis = 1 : i32, factor = 16 : i64, {{.*}}persistent_coverage = false}, {axis = 0 : i32, factor = 4 : i64, {{.*}}persistent_coverage = true}]
# Q: tt.get_num_programs x
# Q: scf.for
# Q: tt.store

# K-NOT: hacc.independent_axis_tensorize
# K: module attributes {hacc.grid_specialization = {grid_0 = 4096 : i64, grid_1 = 1 : i64, grid_2 = 1 : i64, rule_mask = 2048 : i64, version = 1 : i64}, hacc.persistent_task_strip_mining, hacc.program_grid_transforms = {transforms = [{axis = 0 : i32, factor = 64 : i64, {{.*}}persistent_coverage = true}]
# K: tt.get_num_programs x
# K: scf.for
# K: tt.store
