// RUN: triton-opt %s | FileCheck %s

// CHECK-LABEL: func.func @arith_misc() -> i32 {
// CHECK-NEXT: %[[C0I32:.*]] = arith.constant 0 : i32
// CHECK-NEXT: %[[C1I32:.*]] = arith.constant 1 : i32
// CHECK-NEXT: %[[C2I32:.*]] = arith.constant 2 : i32
// CHECK-NEXT: %[[C0IDX:.*]] = arith.constant 0 : index
// CHECK-NEXT: %[[F0:.*]] = arith.constant 1.500000e+00 : f32
// CHECK-NEXT: %[[F1:.*]] = arith.constant 2.500000e+00 : f32
// CHECK-NEXT: %[[H0:.*]] = arith.constant 1.000000e+00 : f16
// CHECK-NEXT: %[[I8:.*]] = arith.constant 7 : i8
// CHECK-NEXT: %[[UI8:.*]] = arith.constant 9 : i8
// CHECK-NEXT: %[[ADD:.*]] = arith.addi %[[C1I32]], %[[C2I32]] : i32
// CHECK-NEXT: %[[ADDF:.*]] = arith.addf %[[F0]], %[[F1]] : f32
// CHECK-NEXT: %[[AND:.*]] = arith.andi %[[C1I32]], %[[C2I32]] : i32
// CHECK-NEXT: %[[OR:.*]] = arith.ori %[[C1I32]], %[[C2I32]] : i32
// CHECK-NEXT: %[[XOR:.*]] = arith.xori %[[C1I32]], %[[C2I32]] : i32
// CHECK-NEXT: %[[SHL:.*]] = arith.shli %[[C2I32]], %[[C1I32]] : i32
// CHECK-NEXT: %[[CMPI:.*]] = arith.cmpi sgt, %[[C2I32]], %[[C1I32]] : i32
// CHECK-NEXT: %[[CMPF:.*]] = arith.cmpf ogt, %[[F1]], %[[F0]] : f32
// CHECK-NEXT: %[[CEILSI:.*]] = arith.ceildivsi %[[C2I32]], %[[C1I32]] : i32
// CHECK-NEXT: %[[CEILUI:.*]] = arith.ceildivui %[[C2I32]], %[[C1I32]] : i32
// CHECK-NEXT: %[[DIVF:.*]] = arith.divf %[[F1]], %[[F0]] : f32
// CHECK-NEXT: %[[REMSI:.*]] = arith.remsi %[[C2I32]], %[[C1I32]] : i32
// CHECK-NEXT: %[[REMUI:.*]] = arith.remui %[[C2I32]], %[[C1I32]] : i32
// CHECK-NEXT: %[[REMF:.*]] = arith.remf %[[F1]], %[[F0]] : f32
// CHECK-NEXT: %[[MAXSI:.*]] = arith.maxsi %[[C1I32]], %[[C2I32]] : i32
// CHECK-NEXT: %[[MAXUI:.*]] = arith.maxui %[[C1I32]], %[[C2I32]] : i32
// CHECK-NEXT: %[[MAXIMUMF:.*]] = arith.maximumf %[[F0]], %[[F1]] : f32
// CHECK-NEXT: %[[MINSI:.*]] = arith.minsi %[[C1I32]], %[[C2I32]] : i32
// CHECK-NEXT: %[[MINUI:.*]] = arith.minui %[[C1I32]], %[[C2I32]] : i32
// CHECK-NEXT: %[[MINIMUMF:.*]] = arith.minimumf %[[F0]], %[[F1]] : f32
// CHECK-NEXT: %[[MULI:.*]] = arith.muli %[[C1I32]], %[[C2I32]] : i32
// CHECK-NEXT: %[[MULF:.*]] = arith.mulf %[[F0]], %[[F1]] : f32
// CHECK-NEXT: %[[NEGF:.*]] = arith.negf %[[F0]] : f32
// CHECK-NEXT: %[[SUBI:.*]] = arith.subi %[[C2I32]], %[[C1I32]] : i32
// CHECK-NEXT: %[[SUBF:.*]] = arith.subf %[[F1]], %[[F0]] : f32
// CHECK-NEXT: %[[SEL:.*]] = arith.select %[[CMPI]], %[[C2I32]], %[[C1I32]] : i32
// CHECK-NEXT: %[[IDX:.*]] = arith.index_cast %[[C1I32]] : i32 to index
// CHECK-NEXT: %[[IDXU:.*]] = arith.index_castui %[[C2I32]] : i32 to index
// CHECK-NEXT: %[[EXTSI:.*]] = arith.extsi %[[I8]] : i8 to i32
// CHECK-NEXT: %[[EXTUI:.*]] = arith.extui %[[UI8]] : i8 to i32
// CHECK-NEXT: %[[EXTF:.*]] = arith.extf %[[H0]] : f16 to f32
// CHECK-NEXT: %[[TRUNCF:.*]] = arith.truncf %[[F0]] : f32 to f16
// CHECK-NEXT: %[[SITOFP:.*]] = arith.sitofp %[[C2I32]] : i32 to f32
// CHECK-NEXT: %[[UITOFP:.*]] = arith.uitofp %[[C2I32]] : i32 to f32
// CHECK-NEXT: %[[FPTOSI:.*]] = arith.fptosi %[[F0]] : f32 to i32
// CHECK-NEXT: %[[FPTOUI:.*]] = arith.fptoui %[[F1]] : f32 to i32
// CHECK-NEXT: %[[BITS:.*]] = arith.bitcast %[[C1I32]] : i32 to f32
// CHECK-NEXT: %[[LO:.*]], %[[HI:.*]] = arith.mului_extended %[[C1I32]], %[[C2I32]] : i32
// CHECK: return %{{.*}} : i32
func.func @arith_misc() -> i32 {
  %c0 = arith.constant 0 : i32
  %c1 = arith.constant 1 : i32
  %c2 = arith.constant 2 : i32
  %idx0 = arith.constant 0 : index
  %f0 = arith.constant 1.500000e+00 : f32
  %f1 = arith.constant 2.500000e+00 : f32
  %h0 = arith.constant 1.000000e+00 : f16
  %i8 = arith.constant 7 : i8
  %ui8 = arith.constant 9 : i8
  %add = arith.addi %c1, %c2 : i32
  %addf = arith.addf %f0, %f1 : f32
  %andv = arith.andi %c1, %c2 : i32
  %orv = arith.ori %c1, %c2 : i32
  %xorv = arith.xori %c1, %c2 : i32
  %shl = arith.shli %c2, %c1 : i32
  %cmpi = arith.cmpi sgt, %c2, %c1 : i32
  %cmpf = arith.cmpf ogt, %f1, %f0 : f32
  %ceilsi = arith.ceildivsi %c2, %c1 : i32
  %ceilui = arith.ceildivui %c2, %c1 : i32
  %divf = arith.divf %f1, %f0 : f32
  %remsi = arith.remsi %c2, %c1 : i32
  %remui = arith.remui %c2, %c1 : i32
  %remf = arith.remf %f1, %f0 : f32
  %maxsi = arith.maxsi %c1, %c2 : i32
  %maxui = arith.maxui %c1, %c2 : i32
  %maximumf = arith.maximumf %f0, %f1 : f32
  %minsi = arith.minsi %c1, %c2 : i32
  %minui = arith.minui %c1, %c2 : i32
  %minimumf = arith.minimumf %f0, %f1 : f32
  %muli = arith.muli %c1, %c2 : i32
  %mulf = arith.mulf %f0, %f1 : f32
  %negf = arith.negf %f0 : f32
  %subi = arith.subi %c2, %c1 : i32
  %subf = arith.subf %f1, %f0 : f32
  %sel = arith.select %cmpi, %c2, %c1 : i32
  %idx = arith.index_cast %c1 : i32 to index
  %idxu = arith.index_castui %c2 : i32 to index
  %extsi = arith.extsi %i8 : i8 to i32
  %extui = arith.extui %ui8 : i8 to i32
  %extf = arith.extf %h0 : f16 to f32
  %truncf = arith.truncf %f0 : f32 to f16
  %sitofp = arith.sitofp %c2 : i32 to f32
  %uitofp = arith.uitofp %c2 : i32 to f32
  %fptosi = arith.fptosi %f0 : f32 to i32
  %fptoui = arith.fptoui %f1 : f32 to i32
  %bits = arith.bitcast %c1 : i32 to f32
  %lo, %hi = arith.mului_extended %c1, %c2 : i32
  %sum0 = arith.addi %add, %andv : i32
  %sum1 = arith.addi %orv, %xorv : i32
  %sum2 = arith.addi %shl, %ceilsi : i32
  %sum3 = arith.addi %ceilui, %remsi : i32
  %sum4 = arith.addi %remui, %maxsi : i32
  %sum5 = arith.addi %maxui, %minsi : i32
  %sum6 = arith.addi %minui, %muli : i32
  %sum7 = arith.addi %subi, %sel : i32
  %sum8 = arith.addi %extsi, %extui : i32
  %sum9 = arith.addi %fptosi, %fptoui : i32
  %sum10 = arith.addi %lo, %hi : i32
  %sum11 = arith.addi %c0, %sum0 : i32
  %sum12 = arith.addi %sum1, %sum2 : i32
  %sum13 = arith.addi %sum3, %sum4 : i32
  %sum14 = arith.addi %sum5, %sum6 : i32
  %sum15 = arith.addi %sum7, %sum8 : i32
  %sum16 = arith.addi %sum9, %sum10 : i32
  %sum17 = arith.addi %sum11, %sum12 : i32
  %sum18 = arith.addi %sum13, %sum14 : i32
  %sum19 = arith.addi %sum15, %sum16 : i32
  %sum20 = arith.addi %sum17, %sum18 : i32
  %sum21 = arith.addi %sum20, %sum19 : i32
  return %sum21 : i32
}
